---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolCard from '../../components/home/ToolCard.astro';
import categoriesData from '../../data/categories.json';
import toolsData from '../../data/tools.json';

export function getStaticPaths() {
  return categoriesData.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const categoryTools = toolsData.filter((tool) => tool.category === category.slug);

const siteUrl = "https://webcreatortools.com";
const pageUrl = `${siteUrl}/${category.slug}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: category.title, item: pageUrl },
  ],
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: category.metaTitle,
  description: category.metaDescription,
  url: pageUrl,
};

const badgeStyles: Record<string, string> = {
  teal: "bg-teal-50 text-teal-600",
  purple: "bg-purple-50 text-purple-600",
  green: "bg-green-50 text-green-600",
};

const toolLabel = categoryTools.length === 1 ? "tool" : "tools";
---

<MainLayout
  title={category.metaTitle}
  description={category.metaDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <!-- Breadcrumb -->
  <nav class="mx-auto max-w-6xl px-4 pt-6 text-sm text-slate-500" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li><a href="/" class="hover:text-brand-600">Home</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-slate-900">{category.title}</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="border-b border-slate-100 bg-slate-50/60">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center">
      <div class={`mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl ${badgeStyles[category.badgeColor]}`}>
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d={category.iconPath} />
        </svg>
      </div>

      <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl">
        {category.title}
      </h1>

      <p class="mt-4 text-slate-600">
        {category.description}
      </p>

      <span class="mt-5 inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-500">
        {categoryTools.length} {toolLabel} available
      </span>
    </div>
  </section>

  <!-- Tools in this category -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categoryTools.map((tool) => (
        <ToolCard
          title={tool.title}
          description={tool.description}
          href={`/${tool.category}/${tool.slug}/`}
          badgeColor={tool.badgeColor}
          iconPath={tool.iconPath}
        />
      ))}
    </div>

    {categoryTools.length === 0 && (
      <p class="text-center text-slate-500">
        Tools for this category are coming soon.
      </p>
    )}
  </section>

  <!-- Written content, SEO requirement -->
  <section class="border-t border-slate-100 bg-slate-50/60">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <div class="text-center">
        <span class="text-xs font-semibold uppercase tracking-wider text-brand-500">
          About this collection
        </span>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">
          {category.title}
        </h2>
      </div>

      <div class="mx-auto mt-10 max-w-3xl space-y-6">
        {category.intro.map((block) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6" set:html={block} />
        ))}
      </div>
    </div>
  </section>

</MainLayout>