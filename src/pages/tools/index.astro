---
import MainLayout from '../../layouts/MainLayout.astro';
import toolsData from '../../data/tools.json';
import categoriesData from '../../data/categories.json';

const toolsByCategory = categoriesData.map((category) => ({
  ...category,
  tools: toolsData.filter((tool) => tool.category === category.slug),
}));
---

<MainLayout
  title="All Tools"
  description="Browse every free tool on Pixelquil, SVG & design, developer utilities, and technical SEO, all in one place."
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600">
      All tools
    </span>
    <h1 class="mt-6 text-4xl font-bold text-slate-900 sm:text-5xl">Browse every tool</h1>
    <p class="mt-4 max-w-xl text-slate-600">
      {toolsData.length} free tools across SVG & design, developer utilities, and technical SEO.
    </p>

    <!-- Search -->
    <div class="mt-8 relative max-w-md">
      <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="7" cy="7" r="5" />
        <path d="M14 14l-3-3" stroke-linecap="round" />
      </svg>
      <input
        type="text"
        data-tool-search
        placeholder="Search tools..."
        class="w-full rounded-lg border border-slate-300 py-2.5 pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-brand-200"
      />
    </div>

    <!-- Flat search results grid, hidden by default -->
    <div data-search-results class="mt-10 hidden">
      <p data-search-count class="mb-4 text-sm text-slate-500"></p>
      <div data-search-grid class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
      <p data-search-empty class="hidden text-sm text-slate-400">No tools match your search.</p>
    </div>

    <!-- Category shelves, hidden while searching -->
    <div data-category-shelves>
      {toolsByCategory.map((category) => (
        <div class="mt-12">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-xl font-bold text-slate-900">{category.title}</h2>
            <a href={`/${category.slug}/`} class="text-sm font-medium text-brand-600 hover:underline">
              View category &rarr;
            </a>
          </div>

        <div class="max-h-[420px] overflow-y-auto pr-2 scrollbar-thin">
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {category.tools.map((tool) => (
              <a href={`/${category.slug}/${tool.slug}/`}
                class="tool-card group flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-5 hover:border-brand-300"
                data-tool-name={tool.title.toLowerCase()}
                data-tool-desc={tool.description.toLowerCase()}
              >
                <svg
                  class="h-9 w-9 text-brand-600"
                  viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round"
                >
                  <path d={tool.iconPath} />
                </svg>
                <div>
                  <h3 class="text-sm font-semibold text-slate-900">{tool.title}</h3>
                  <p class="mt-1 text-xs leading-relaxed text-slate-500 line-clamp-2">{tool.description}</p>
                </div>
              </a>
            ))}
          </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</MainLayout>

<script define:vars={{ allTools: toolsData }}>
  const searchInput = document.querySelector("[data-tool-search]");
  const searchResults = document.querySelector("[data-search-results]");
  const searchGrid = document.querySelector("[data-search-grid]");
  const searchCount = document.querySelector("[data-search-count]");
  const searchEmpty = document.querySelector("[data-search-empty]");
  const shelves = document.querySelector("[data-category-shelves]");

  function cardHTML(tool) {
    const href = `/${tool.category}/${tool.slug}/`;
    return `
      <a href="${href}" class="flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-5 hover:border-brand-300">
        <svg class="h-9 w-9 text-brand-600" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="${tool.iconPath}" />
        </svg>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">${tool.title}</h3>
          <p class="mt-1 text-xs leading-relaxed text-slate-500">${tool.description}</p>
        </div>
      </a>`;
  }

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.trim().toLowerCase();

    if (!query) {
      searchResults?.classList.add("hidden");
      shelves?.classList.remove("hidden");
      return;
    }

    shelves?.classList.add("hidden");
    searchResults?.classList.remove("hidden");

    const matches = allTools.filter(
      (tool) =>
        tool.title.toLowerCase().includes(query) ||
        tool.description.toLowerCase().includes(query)
    );

    searchCount.textContent = `${matches.length} tool${matches.length === 1 ? "" : "s"} found`;

    if (matches.length === 0) {
      searchGrid.innerHTML = "";
      searchEmpty?.classList.remove("hidden");
    } else {
      searchEmpty?.classList.add("hidden");
      searchGrid.innerHTML = matches.map(cardHTML).join("");
    }
  });
</script>

<style>
  .scrollbar-thin {
    scrollbar-width: thin;
    scrollbar-color: #c7d2fe transparent;
  }

  .scrollbar-thin::-webkit-scrollbar {
    height: 6px;
  }

  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }

  .scrollbar-thin::-webkit-scrollbar-thumb {
    background-color: #c7d2fe;
    border-radius: 999px;
  }

  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background-color: #a5b4fc;
  }
</style>
