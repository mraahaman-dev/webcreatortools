<section class="mx-auto max-w-6xl px-4 py-20" data-recent-tools-section style="display:none;">
  <div class="mb-12 max-w-xl">
    <span class="text-xs font-semibold uppercase tracking-wider text-brand-500">Welcome back</span>
    <h2 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">Pick up where you left off</h2>
    <p class="mt-3 text-slate-600">Tools you've recently opened on this device.</p>
  </div>

  <div data-recent-tools-grid class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4"></div>
</section>

<script>
  const BADGE_COLOR_CLASSES: Record<string, string> = {
    indigo: "bg-indigo-50 text-indigo-600",
    blue: "bg-blue-50 text-blue-600",
    purple: "bg-purple-50 text-purple-600",
    amber: "bg-amber-50 text-amber-600",
    teal: "bg-teal-50 text-teal-600",
    green: "bg-green-50 text-green-600",
    pink: "bg-pink-50 text-pink-600",
  };

  function initRecentTools() {
    const STORAGE_KEY = "pixelquil-recent-tools";
    const section = document.querySelector<HTMLElement>("[data-recent-tools-section]");
    const grid = document.querySelector<HTMLElement>("[data-recent-tools-grid]");
    if (!section || !grid) return;

    let recent: { title: string; href: string; iconPath: string; badgeColor: string }[] = [];
    try {
      recent = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
    } catch {
      recent = [];
    }

    if (!recent || recent.length === 0) return;

    section.style.display = "";
    grid.innerHTML = recent
      .slice(0, 4)
      .map((tool) => {
        const colorClass = BADGE_COLOR_CLASSES[tool.badgeColor] || BADGE_COLOR_CLASSES.indigo;
        return `
        <a href="${tool.href}" class="group rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-md">
          <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl ${colorClass}">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="${tool.iconPath}" />
            </svg>
          </div>
          <div class="text-sm font-semibold text-slate-800 group-hover:text-brand-600">${tool.title}</div>
          <div class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-brand-500">
            Open Tool
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </div>
        </a>`;
      })
      .join("");
  }

  document.addEventListener("DOMContentLoaded", initRecentTools);
  // Also run immediately in case DOMContentLoaded already fired (e.g. Astro view transitions).
  if (document.readyState !== "loading") initRecentTools();
</script>