<style>
  .faq-item {
    opacity: 0;
    animation: faqFadeIn 0.5s ease-out forwards;
  }

  @keyframes faqFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .faq-illustration {
    opacity: 0;
    animation: faqFadeIn 0.6s ease-out 0.15s forwards;
  }

  details[open] .faq-panel {
    grid-template-rows: 1fr;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item, .faq-illustration {
      animation: none;
      opacity: 1;
    }
    .faq-panel {
      transition: none;
    }
  }
</style>

<script>
  // Ensures the open/close arrow + panel state stays in sync when details
  // is toggled via keyboard or programmatically, not just mouse click.
  document.querySelectorAll(".faq-item").forEach((item) => {
    item.addEventListener("toggle", () => {
      // No-op hook: CSS handles the grid-template-rows transition via [open].
      // Left here in case you want to add analytics or lazy-load behavior later.
    });
  });
</script>