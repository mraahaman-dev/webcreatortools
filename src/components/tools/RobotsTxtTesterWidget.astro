<div class="robots-txt-tester" data-robots-txt-tester>
  <div class="flex flex-wrap items-center gap-2 rounded-t-2xl border border-b-0 border-slate-200 bg-slate-50 p-3">
    <input type="text" data-fetch-url-input placeholder="https://example.com" spellcheck="false"
      class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-800 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" />
    <button type="button" data-fetch-btn
      class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50">
      Fetch robots.txt
    </button>
  </div>
  <div data-fetch-status class="hidden border border-b-0 border-slate-200 bg-white p-3 text-xs"></div>

  <div class="border border-b-0 border-slate-200 bg-white p-4">
    <div class="mb-2 flex items-center justify-between text-xs font-medium uppercase tracking-wide text-slate-500">
      <span>robots.txt content</span>
      <span data-sitemap-count class="normal-case text-slate-400"></span>
    </div>
    <textarea data-robots-input spellcheck="false"
      class="h-56 w-full resize-y rounded-lg border border-slate-200 bg-slate-50 p-3 font-mono text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-200"
      placeholder="Paste your robots.txt content here"
    >User-agent: *
Disallow: /admin/
Disallow: /cart
Allow: /cart/share

User-agent: GPTBot
Disallow: /

Sitemap: https://example.com/sitemap.xml</textarea>
  </div>

  <div class="border border-b-0 border-slate-200 bg-white p-5">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="mb-1 block text-xs text-slate-600">User-agent to test</span>
        <div class="flex gap-2">
          <input type="text" data-agent-input value="*" spellcheck="false"
            class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-800 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" />
          <select data-agent-preset class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-xs text-slate-700">
            <option value="">Presets</option>
            <option value="*">* (all bots)</option>
            <option value="Googlebot">Googlebot</option>
            <option value="Bingbot">Bingbot</option>
            <option value="GPTBot">GPTBot</option>
            <option value="ClaudeBot">ClaudeBot</option>
            <option value="PerplexityBot">PerplexityBot</option>
          </select>
        </div>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs text-slate-600">URL path to test</span>
        <input type="text" data-path-input value="/" spellcheck="false"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-800 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" />
      </label>
    </div>
  </div>

  <div class="rounded-b-2xl border border-slate-200 bg-white p-5">
    <div data-result-panel class="mb-4 rounded-lg border p-4"></div>
    <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Rules applied for this user-agent</h3>
    <ul data-rules-list class="space-y-1 font-mono text-xs text-slate-600"></ul>
  </div>

  <p class="mt-3 text-xs text-slate-400">
    Everything runs in your browser. Paste your robots.txt content directly, live URL fetching isn't available yet.
  </p>
</div>

<script>
  interface Rule { type: "allow" | "disallow"; path: string }
  interface Group { agents: string[]; rules: Rule[] }

  function parseRobotsTxt(text: string): { groups: Group[]; sitemaps: string[] } {
    const groups: Group[] = [];
    const sitemaps: string[] = [];
    let currentGroup: Group | null = null;
    let lastWasAgent = false;

    text.split("\n").forEach((rawLine) => {
      const line = rawLine.split("#")[0].trim();
      if (!line) return;
      const colonIdx = line.indexOf(":");
      if (colonIdx === -1) return;
      const field = line.slice(0, colonIdx).trim().toLowerCase();
      const value = line.slice(colonIdx + 1).trim();

      if (field === "user-agent") {
        if (!currentGroup || !lastWasAgent) {
          currentGroup = { agents: [], rules: [] };
          groups.push(currentGroup);
        }
        currentGroup.agents.push(value.toLowerCase());
        lastWasAgent = true;
      } else if (field === "allow" || field === "disallow") {
        if (!currentGroup) return;
        if (field === "disallow" && value === "") return; // empty disallow = no restriction, skip
        currentGroup.rules.push({ type: field, path: value });
        lastWasAgent = false;
      } else if (field === "sitemap") {
        sitemaps.push(value);
        lastWasAgent = false;
      } else {
        lastWasAgent = false;
      }
    });

    return { groups, sitemaps };
  }

  function patternToRegex(pattern: string): RegExp {
    let escaped = pattern.replace(/[.+^${}()|[\]\\]/g, "\\$&");
    const endsWithDollar = escaped.endsWith("\\$");
    if (endsWithDollar) escaped = escaped.slice(0, -2);
    escaped = escaped.replace(/\*/g, ".*");
    return new RegExp("^" + escaped + (endsWithDollar ? "$" : ""));
  }

  function selectGroup(groups: Group[], userAgent: string): Group | null {
    const ua = userAgent.toLowerCase();
    const exact = groups.find((g) => g.agents.includes(ua));
    if (exact) return exact;
    return groups.find((g) => g.agents.includes("*")) ?? null;
  }

  function checkPath(groups: Group[], userAgent: string, path: string) {
    const group = selectGroup(groups, userAgent);
    if (!group) {
      return { allowed: true, matched: null, group: null, reason: "No matching group found for this user-agent, defaulting to allowed." };
    }

    const candidates = group.rules
      .map((r) => ({ ...r, regex: patternToRegex(r.path) }))
      .filter((r) => r.regex.test(path));

    if (candidates.length === 0) {
      return { allowed: true, matched: null, group, reason: "No rule in this group matches the path, defaulting to allowed." };
    }

    candidates.sort((a, b) => {
      if (b.path.length !== a.path.length) return b.path.length - a.path.length;
      // Tie: Allow wins over Disallow.
      return a.type === "allow" ? -1 : b.type === "allow" ? 1 : 0;
    });

    const best = candidates[0];
    return { allowed: best.type === "allow", matched: best, group, reason: null };
  }

 async function fetchWithRedirects(url: string, maxHops = 5): Promise<{ body: string; status: number; finalUrl: string } | { error: string }> {
    let current = url;
    for (let i = 0; i < maxHops; i++) {
      const res = await fetch(`/api/fetch-proxy/?url=${encodeURIComponent(current)}`);
      if (!res.ok && res.status !== 400 && res.status !== 502) {
        return { error: `/api/fetch-proxy responded with HTTP ${res.status} (route may not exist in this environment)` };
      }
      let data: any;
      try {
        data = await res.json();
      } catch {
        return { error: "The proxy endpoint didn't return valid JSON — it may not be running in this environment" };
      }
      if (data.error) return { error: data.error };

      if (data.status >= 300 && data.status < 400 && data.headers?.location) {
        current = new URL(data.headers.location, current).toString();
        continue;
      }
      return { body: data.body, status: data.status, finalUrl: data.finalUrl || current };
    }
    return { error: "Too many redirects" };
  }

  function initRobotsTxtTester(root: HTMLElement) {
    const robotsInput = root.querySelector<HTMLTextAreaElement>("[data-robots-input]")!;
    const fetchUrlInput = root.querySelector<HTMLInputElement>("[data-fetch-url-input]")!;
    const fetchBtn = root.querySelector<HTMLButtonElement>("[data-fetch-btn]")!;
    const fetchStatus = root.querySelector<HTMLDivElement>("[data-fetch-status]")!;
    const agentInput = root.querySelector<HTMLInputElement>("[data-agent-input]")!;
    const agentPreset = root.querySelector<HTMLSelectElement>("[data-agent-preset]")!;
    const pathInput = root.querySelector<HTMLInputElement>("[data-path-input]")!;
    const resultPanel = root.querySelector<HTMLDivElement>("[data-result-panel]")!;
    const rulesList = root.querySelector<HTMLUListElement>("[data-rules-list]")!;
    const sitemapCount = root.querySelector<HTMLSpanElement>("[data-sitemap-count]")!;

    function run() {
      const { groups, sitemaps } = parseRobotsTxt(robotsInput.value);
      sitemapCount.textContent = sitemaps.length ? `${sitemaps.length} sitemap${sitemaps.length === 1 ? "" : "s"} found` : "";

      const agent = agentInput.value.trim() || "*";
      const path = pathInput.value.trim() || "/";
      const result = checkPath(groups, agent, path);

      resultPanel.className = `mb-4 rounded-lg border p-4 ${
        result.allowed ? "border-green-200 bg-green-50" : "border-red-200 bg-red-50"
      }`;
      resultPanel.innerHTML = `
        <div class="flex items-center gap-2 text-sm font-semibold ${result.allowed ? "text-green-700" : "text-red-700"}">
          ${
            result.allowed
              ? '<svg class="h-5 w-5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l3.5 3.5L13 5" stroke-linecap="round" stroke-linejoin="round"/></svg>'
              : '<svg class="h-5 w-5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4l8 8M12 4l-8 8" stroke-linecap="round"/></svg>'
          }
          ${result.allowed ? "Allowed" : "Blocked"} for "${agent}" on ${path}
        </div>
        <p class="mt-1 text-xs ${result.allowed ? "text-green-600" : "text-red-600"}">
          ${
            result.matched
              ? `Matched rule: ${result.matched.type === "allow" ? "Allow" : "Disallow"}: ${result.matched.path || "(empty)"}`
              : result.reason
          }
        </p>
      `;

      const group = result.group;
      if (!group || group.rules.length === 0) {
        rulesList.innerHTML = '<li class="text-slate-400">No specific rules found for this user-agent.</li>';
      } else {
        rulesList.innerHTML = group.rules
          .map(
            (r) =>
              `<li class="rounded bg-slate-50 px-2 py-1 ${result.matched === r ? "ring-2 ring-indigo-300" : ""}">${
                r.type === "allow" ? "Allow" : "Disallow"
              }: ${r.path || "(empty)"}</li>`
          )
          .join("");
      }
    }

    fetchBtn.addEventListener("click", async () => {
      let domain = fetchUrlInput.value.trim();
      if (!domain) return;
      if (!/^https?:\/\//i.test(domain)) domain = "https://" + domain;

      let robotsUrl: string;
      try {
        robotsUrl = new URL("/robots.txt", domain).toString();
      } catch {
        fetchStatus.classList.remove("hidden");
        fetchStatus.className = "border border-b-0 border-red-200 bg-red-50 p-3 text-xs text-red-700";
        fetchStatus.textContent = "That doesn't look like a valid URL.";
        return;
      }

      fetchBtn.disabled = true;
      fetchBtn.textContent = "Fetching...";
      fetchStatus.classList.add("hidden");

      let result: Awaited<ReturnType<typeof fetchWithRedirects>>;
      try {
        result = await fetchWithRedirects(robotsUrl);
      } catch (err) {
        fetchBtn.disabled = false;
        fetchBtn.textContent = "Fetch robots.txt";
        fetchStatus.classList.remove("hidden");
        fetchStatus.className = "border border-b-0 border-red-200 bg-red-50 p-3 text-xs text-red-700";
        fetchStatus.textContent = `Request failed: ${err instanceof Error ? err.message : "unknown error"}. Check the browser console for details.`;
        console.error("fetch-proxy request failed:", err);
        return;
      }

      fetchBtn.disabled = false;
      fetchBtn.textContent = "Fetch robots.txt";

      if ("error" in result) {
        fetchStatus.classList.remove("hidden");
        fetchStatus.className = "border border-b-0 border-red-200 bg-red-50 p-3 text-xs text-red-700";
        fetchStatus.textContent = `Could not fetch: ${result.error}`;
        return;
      }

      if (result.status >= 400) {
        fetchStatus.classList.remove("hidden");
        fetchStatus.className = "border border-b-0 border-amber-200 bg-amber-50 p-3 text-xs text-amber-700";
        fetchStatus.textContent = `${result.finalUrl} returned status ${result.status}. No robots.txt found, meaning everything is allowed by default.`;
        robotsInput.value = "";
        run();
        return;
      }

      fetchStatus.classList.remove("hidden");
      fetchStatus.className = "border border-b-0 border-green-200 bg-green-50 p-3 text-xs text-green-700";
      fetchStatus.textContent = `Fetched from ${result.finalUrl}`;
      robotsInput.value = result.body;
      run();
    });

    robotsInput.addEventListener("input", run);
    agentInput.addEventListener("input", run);
    pathInput.addEventListener("input", run);
    agentPreset.addEventListener("change", () => {
      if (agentPreset.value) {
        agentInput.value = agentPreset.value;
        run();
      }
    });

    run();
  }

  document.querySelectorAll<HTMLElement>("[data-robots-txt-tester]").forEach(initRobotsTxtTester);
</script>