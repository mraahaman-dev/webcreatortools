<div class="meta-tag-extractor" data-meta-tag-extractor>
  <div class="flex flex-wrap items-center gap-2 rounded-t-2xl border border-b-0 border-slate-200 bg-slate-50 p-3">
    <input type="text" data-url-input placeholder="https://example.com" spellcheck="false"
      class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-800 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" />
    <button type="button" data-extract-btn
      class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50">
      Extract Tags
    </button>
  </div>

  <div data-status-panel class="hidden border border-b-0 border-slate-200 bg-white p-4 text-sm"></div>

  <div class="rounded-b-2xl border border-slate-200 bg-white p-5">
    <div data-results-panel>
      <p class="text-sm text-slate-400">Enter a URL above and click Extract Tags.</p>
    </div>
  </div>

  <p class="mt-3 text-xs text-slate-400">
    Fetched through a small server-side proxy. Nothing about the page you check is stored.
  </p>
</div>

<script>
  interface MetaEntry { key: string; value: string }

  function extractMeta(html: string): { seo: MetaEntry[]; og: MetaEntry[]; twitter: MetaEntry[]; other: MetaEntry[]; title: string | null; canonical: string | null } {
    const parser = new DOMParser();
    const doc = parser.parseFromString(html, "text/html");

    const titleEl = doc.querySelector("title");
    const title = titleEl ? titleEl.textContent?.trim() ?? null : null;

    const canonicalEl = doc.querySelector('link[rel="canonical"]');
    const canonical = canonicalEl ? canonicalEl.getAttribute("href") : null;

    const seo: MetaEntry[] = [];
    const og: MetaEntry[] = [];
    const twitter: MetaEntry[] = [];
    const other: MetaEntry[] = [];

    const SEO_NAMES = new Set(["description", "robots", "keywords", "viewport", "author", "theme-color"]);

    doc.querySelectorAll("meta").forEach((el) => {
      const name = el.getAttribute("name");
      const property = el.getAttribute("property");
      const httpEquiv = el.getAttribute("http-equiv");
      const content = el.getAttribute("content") ?? "";
      const charset = el.getAttribute("charset");

      if (charset) {
        other.push({ key: "charset", value: charset });
        return;
      }

      const key = property || name || httpEquiv;
      if (!key || content === "") return;

      if (key.startsWith("og:")) {
        og.push({ key, value: content });
      } else if (key.startsWith("twitter:")) {
        twitter.push({ key, value: content });
      } else if (SEO_NAMES.has(key.toLowerCase())) {
        seo.push({ key, value: content });
      } else {
        other.push({ key, value: content });
      }
    });

    return { seo, og, twitter, other, title, canonical };
  }

  function escapeHtml(text: string): string {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  function renderGroup(title: string, entries: MetaEntry[], colorClass: string): string {
    if (entries.length === 0) return "";
    return `
      <div class="mb-4">
        <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide ${colorClass}">${title}</h3>
        <div class="space-y-1.5 rounded-lg border border-slate-100">
          ${entries
            .map(
              (e) => `
            <div class="flex gap-3 border-b border-slate-50 px-3 py-2 last:border-b-0">
              <span class="w-36 shrink-0 font-mono text-xs text-slate-500">${escapeHtml(e.key)}</span>
              <span class="min-w-0 flex-1 break-words text-xs text-slate-800">${escapeHtml(e.value)}</span>
            </div>`
            )
            .join("")}
        </div>
      </div>`;
  }

  function initMetaTagExtractor(root: HTMLElement) {
    const urlInput = root.querySelector<HTMLInputElement>("[data-url-input]")!;
    const extractBtn = root.querySelector<HTMLButtonElement>("[data-extract-btn]")!;
    const statusPanel = root.querySelector<HTMLDivElement>("[data-status-panel]")!;
    const resultsPanel = root.querySelector<HTMLDivElement>("[data-results-panel]")!;

    extractBtn.addEventListener("click", async () => {
      let target = urlInput.value.trim();
      if (!target) return;
      if (!/^https?:\/\//i.test(target)) target = "https://" + target;

      extractBtn.disabled = true;
      extractBtn.textContent = "Extracting...";
      statusPanel.classList.add("hidden");
      resultsPanel.innerHTML = '<p class="text-sm text-slate-400">Fetching page...</p>';

      let res: Response;
      let data: any;
      try {
        res = await fetch(`/api/fetch-proxy/?url=${encodeURIComponent(target)}`);
        data = await res.json();
      } catch {
        extractBtn.disabled = false;
        extractBtn.textContent = "Extract Tags";
        resultsPanel.innerHTML = "";
        statusPanel.classList.remove("hidden");
        statusPanel.className = "border border-b-0 border-red-200 bg-red-50 p-4 text-sm text-red-700";
        statusPanel.textContent = "Could not reach the proxy.";
        return;
      }

      extractBtn.disabled = false;
      extractBtn.textContent = "Extract Tags";

      if (data.error || data.status >= 400) {
        resultsPanel.innerHTML = "";
        statusPanel.classList.remove("hidden");
        statusPanel.className = "border border-b-0 border-red-200 bg-red-50 p-4 text-sm text-red-700";
        statusPanel.textContent = data.error || `The page returned status ${data.status}, no tags to extract.`;
        return;
      }

      statusPanel.classList.add("hidden");

      const { seo, og, twitter, other, title, canonical } = extractMeta(data.body);

      const titleBlock = title
        ? `<div class="mb-4 rounded-lg border border-indigo-100 bg-indigo-50 p-3">
             <div class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Title tag</div>
             <div class="mt-1 text-sm text-slate-800">${escapeHtml(title)}</div>
             <div class="mt-1 text-xs text-slate-400">${title.length} characters</div>
           </div>`
        : `<div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-xs text-red-700">No &lt;title&gt; tag found.</div>`;

      const canonicalBlock = canonical
        ? `<div class="mb-4 rounded-lg border border-slate-100 p-3">
             <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">Canonical URL</div>
             <div class="mt-1 break-all font-mono text-xs text-slate-800">${escapeHtml(canonical)}</div>
           </div>`
        : "";

      const groups = [
        renderGroup("SEO meta tags", seo, "text-indigo-600"),
        renderGroup("Open Graph", og, "text-purple-600"),
        renderGroup("Twitter Card", twitter, "text-blue-600"),
        renderGroup("Other tags", other, "text-slate-500"),
      ].join("");

      const totalTags = seo.length + og.length + twitter.length + other.length;

      resultsPanel.innerHTML = `
        <div class="mb-4 text-xs text-slate-400">${totalTags} meta tag${totalTags === 1 ? "" : "s"} found${canonical ? " · canonical present" : ""}</div>
        ${titleBlock}
        ${canonicalBlock}
        ${groups || '<p class="text-sm text-slate-400">No additional meta tags found on this page.</p>'}
      `;
    });

    urlInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") extractBtn.click();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-meta-tag-extractor]").forEach(initMetaTagExtractor);
</script>