<div class="redirect-chain-checker" data-redirect-chain-checker>
  <div class="flex flex-wrap items-center gap-2 rounded-t-2xl border border-b-0 border-slate-200 bg-slate-50 p-3">
    <input type="text" data-url-input placeholder="https://example.com/old-page" spellcheck="false"
      class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100" />
    <button type="button" data-check-btn
      class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50">
      Check Redirects
    </button>
  </div>

  <div data-status-panel class="hidden border border-b-0 border-slate-200 bg-white p-4 text-sm"></div>

  <div class="rounded-b-2xl border border-slate-200 bg-white p-5">
    <div data-hops-list class="space-y-0">
      <p class="text-sm text-slate-400">Enter a URL above to trace its full redirect chain, hop by hop.</p>
    </div>
  </div>

  <p class="mt-3 text-xs text-slate-400">
    Fetched through a small server-side proxy, since browsers can't read cross-origin redirect headers directly. Nothing is stored.
  </p>
</div>

<script>
  interface Hop {
    url: string;
    status: number;
    statusText: string;
    location: string | null;
  }

  const MAX_HOPS = 20;

  function statusBadgeClasses(status: number): string {
    if (status >= 200 && status < 300) return "bg-green-100 text-green-700";
    if (status >= 300 && status < 400) return "bg-amber-100 text-amber-700";
    if (status >= 400) return "bg-red-100 text-red-700";
    return "bg-slate-100 text-slate-700";
  }

  function redirectTypeLabel(status: number): string {
    if (status === 301) return "301 — Permanent";
    if (status === 302) return "302 — Found (temporary)";
    if (status === 307) return "307 — Temporary (method preserved)";
    if (status === 308) return "308 — Permanent (method preserved)";
    if (status >= 300 && status < 400) return `${status} — Redirect`;
    return String(status);
  }

  async function traceRedirectChain(startUrl: string): Promise<{ hops: Hop[]; error: string | null; loopDetected: boolean; truncated: boolean }> {
    const hops: Hop[] = [];
    const visited = new Set<string>();
    let current = startUrl;

    for (let i = 0; i < MAX_HOPS; i++) {
      if (visited.has(current)) {
        return { hops, error: null, loopDetected: true, truncated: false };
      }
      visited.add(current);

      let res: Response;
      try {
        res = await fetch(`/api/fetch-proxy/?url=${encodeURIComponent(current)}`);
      } catch (err) {
        console.error("fetch-proxy request failed:", err);
        return { hops, error: "Network error while contacting the proxy.", loopDetected: false, truncated: false };
      }

      if (!res.ok && res.status !== 400 && res.status !== 502) {
        const bodyPreview = await res.text().catch(() => "");
        console.error(`fetch-proxy returned HTTP ${res.status}:`, bodyPreview.slice(0, 500));
        return {
          hops,
          error: `/api/fetch-proxy responded with HTTP ${res.status} (see browser console for the response body)`,
          loopDetected: false,
          truncated: false,
        };
      }

      let data: any;
      try {
        data = await res.json();
      } catch (err) {
        const bodyPreview = await res.clone().text().catch(() => "");
        console.error("fetch-proxy returned non-JSON response:", bodyPreview.slice(0, 500));
        return { hops, error: "The proxy did not return a valid response — check the browser console for details.", loopDetected: false, truncated: false };
      }

      if (data.error) {
        return { hops, error: data.error, loopDetected: false, truncated: false };
      }

      const location = data.headers?.location ?? null;
      hops.push({ url: current, status: data.status, statusText: data.statusText, location });

      if (data.status >= 300 && data.status < 400 && location) {
        current = new URL(location, current).toString();
        continue;
      }

      return { hops, error: null, loopDetected: false, truncated: false };
    }

    return { hops, error: null, loopDetected: false, truncated: true };
  }

  function initRedirectChainChecker(root: HTMLElement) {
    const urlInput = root.querySelector<HTMLInputElement>("[data-url-input]")!;
    const checkBtn = root.querySelector<HTMLButtonElement>("[data-check-btn]")!;
    const statusPanel = root.querySelector<HTMLDivElement>("[data-status-panel]")!;
    const hopsList = root.querySelector<HTMLDivElement>("[data-hops-list]")!;

    function renderHops(hops: Hop[]) {
      hopsList.innerHTML = hops
        .map((hop, i) => {
          const isLast = i === hops.length - 1;
          const isRedirect = hop.status >= 300 && hop.status < 400;
          let originalHost = "";
          let currentHost = "";
          try {
            originalHost = new URL(hops[0].url).hostname;
            currentHost = new URL(hop.url).hostname;
          } catch {}
          const crossDomain = i > 0 && currentHost !== originalHost;

          return `
            <div class="relative pb-6 pl-8 ${isLast ? "" : "border-l-2 border-dashed border-slate-200"}">
              <span class="absolute -left-[9px] top-0 flex h-4 w-4 items-center justify-center rounded-full ${
                isLast && !isRedirect ? "bg-green-600" : "bg-blue-600"
              }">
                <span class="h-1.5 w-1.5 rounded-full bg-white"></span>
              </span>
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs font-semibold text-slate-400">Hop ${i + 1}</span>
                <span class="rounded-full px-2 py-0.5 text-xs font-semibold ${statusBadgeClasses(hop.status)}">
                  ${isRedirect ? redirectTypeLabel(hop.status) : `${hop.status} ${hop.statusText || ""}`}
                </span>
                ${crossDomain ? '<span class="rounded-full bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-700">Cross-domain</span>' : ""}
              </div>
              <div class="mt-1 break-all font-mono text-sm text-slate-800">${hop.url}</div>
              ${
                hop.location
                  ? `<div class="mt-1 text-xs text-slate-500">→ redirects to <span class="font-mono">${hop.location}</span></div>`
                  : ""
              }
            </div>`;
        })
        .join("");
    }

    async function run() {
      let target = urlInput.value.trim();
      if (!target) return;
      if (!/^https?:\/\//i.test(target)) target = "https://" + target;

      checkBtn.disabled = true;
      checkBtn.textContent = "Checking...";
      statusPanel.classList.add("hidden");
      hopsList.innerHTML = '<p class="text-sm text-slate-400">Tracing redirect chain...</p>';

      const result = await traceRedirectChain(target);

      checkBtn.disabled = false;
      checkBtn.textContent = "Check Redirects";

      if (result.error) {
        hopsList.innerHTML = "";
        statusPanel.classList.remove("hidden");
        statusPanel.className = "border border-b-0 border-red-200 bg-red-50 p-4 text-sm text-red-700";
        statusPanel.textContent = `Could not complete the check: ${result.error}`;
        return;
      }

      renderHops(result.hops);

      const redirectCount = result.hops.filter((h) => h.status >= 300 && h.status < 400).length;
      const last = result.hops[result.hops.length - 1];

      statusPanel.classList.remove("hidden");

      if (result.loopDetected) {
        statusPanel.className = "border border-b-0 border-red-200 bg-red-50 p-4 text-sm text-red-700";
        statusPanel.textContent = `Redirect loop detected after ${result.hops.length} hop${result.hops.length === 1 ? "" : "s"} — a URL earlier in the chain was reached again.`;
      } else if (result.truncated) {
        statusPanel.className = "border border-b-0 border-amber-200 bg-amber-50 p-4 text-sm text-amber-700";
        statusPanel.textContent = `Stopped after ${MAX_HOPS} hops without reaching a final destination. This chain is unusually long.`;
      } else if (redirectCount === 0) {
        statusPanel.className = "border border-b-0 border-green-200 bg-green-50 p-4 text-sm text-green-700";
        statusPanel.textContent = `No redirects. This URL responds directly with status ${last.status}.`;
      } else {
        const severityClasses =
          redirectCount === 1
            ? "border border-b-0 border-green-200 bg-green-50 p-4 text-sm text-green-700"
            : redirectCount <= 3
            ? "border border-b-0 border-amber-200 bg-amber-50 p-4 text-sm text-amber-700"
            : "border border-b-0 border-red-200 bg-red-50 p-4 text-sm text-red-700";
        statusPanel.className = severityClasses;
        statusPanel.textContent = `${redirectCount} redirect${redirectCount === 1 ? "" : "s"} before reaching a final ${last.status} response at ${last.url}.${
          redirectCount > 1 ? " Consider updating the original link to point directly at the final destination." : ""
        }`;
      }
    }

    checkBtn.addEventListener("click", run);
    urlInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") run();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-redirect-chain-checker]").forEach(initRedirectChainChecker);
</script>