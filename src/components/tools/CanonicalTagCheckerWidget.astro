---
---

<div data-canonical-tag-checker-widget class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
  <div class="flex flex-wrap items-center gap-2 mb-2">
    <input
      type="text"
      data-fetch-url-input
      placeholder="Fetch from URL https://…"
      spellcheck="false"
      class="min-w-0 flex-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
    />
    <button type="button" data-fetch-btn class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-medium text-white hover:bg-teal-700 disabled:cursor-not-allowed disabled:opacity-50">
      Fetch
    </button>
  </div>
  <p data-fetch-status class="hidden mb-3 text-xs"></p>

  <div class="mb-3">
    <label class="block text-xs font-medium text-gray-600 mb-1">Page URL (what this page's own URL actually is)</label>
    <input
      type="text"
      data-page-url-input
      placeholder="https://example.com/page"
      spellcheck="false"
      class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
    />
    <p class="mt-1 text-xs text-gray-400">Filled automatically when fetching a URL — required when pasting HTML directly, since the HTML alone doesn't say what URL it's served at.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1">HTML</label>
      <textarea
        data-html-input
        rows="12"
        spellcheck="false"
        placeholder='Paste the page&#39;s HTML, or just its &lt;head&gt;, e.g.
&lt;link rel="canonical" href="https://example.com/page" /&gt;'
        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm font-mono text-gray-800 leading-relaxed focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 resize-y"
      ></textarea>
    </div>

    <div>
      <div class="flex items-center justify-between mb-1">
        <label class="text-xs font-medium text-gray-600">Report</label>
        <span data-report-summary class="text-xs text-gray-400"></span>
      </div>
      <ul data-report class="space-y-2 text-sm rounded-lg border border-gray-200 bg-gray-50 p-3 max-h-96 overflow-y-auto">
        <li class="text-gray-400">Paste HTML or fetch a URL to check its canonical tag.</li>
      </ul>
    </div>
  </div>
</div>

<script>
  interface CheckResult { label: string; pass: boolean; detail: string; severity?: "warn" | "info" }

  const TRACKING_PARAMS = new Set([
    "utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content",
    "gclid", "fbclid", "msclkid", "mc_cid", "mc_eid", "ref", "ref_src",
    "igshid", "yclid", "gbraid", "wbraid", "_ga",
  ]);

  function escapeHtml(text: string): string {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  function iconFor(pass: boolean, severity?: "warn" | "info"): string {
    if (pass) {
      return '<svg class="h-4 w-4 shrink-0 text-green-600" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l3.5 3.5L13 5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }
    if (severity === "info") {
      return '<svg class="h-4 w-4 shrink-0 text-blue-500" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="8" r="6.5"/><path d="M8 7v4M8 4.5v.01" stroke-linecap="round"/></svg>';
    }
    return '<svg class="h-4 w-4 shrink-0 text-amber-500" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 5v4M8 11.5v.01" stroke-linecap="round"/><circle cx="8" cy="8" r="6.5"/></svg>';
  }

  function nonTrackingQuery(url: URL): string {
    const params = Array.from(url.searchParams.entries()).filter(([key]) => !TRACKING_PARAMS.has(key.toLowerCase()));
    params.sort(([a], [b]) => a.localeCompare(b));
    return params.map(([k, v]) => `${k}=${v}`).join("&");
  }

  function stripTrailingSlash(path: string): string {
    return path.length > 1 && path.endsWith("/") ? path.slice(0, -1) : path;
  }

  async function fetchWithRedirects(url: string, maxHops = 5): Promise<{ body: string; status: number; finalUrl: string } | { error: string }> {
    let current = url;
    for (let i = 0; i < maxHops; i++) {
      const res = await fetch(`/api/fetch-proxy/?url=${encodeURIComponent(current)}`);
      if (!res.ok && res.status !== 400 && res.status !== 502) {
        return { error: `/api/fetch-proxy responded with HTTP ${res.status}` };
      }
      let data: any;
      try {
        data = await res.json();
      } catch {
        return { error: "The proxy endpoint didn't return valid JSON." };
      }
      if (data.error) return { error: data.error };
      if (data.status >= 300 && data.status < 400 && data.headers?.location) {
        current = new URL(data.headers.location, current).toString();
        continue;
      }
      return { body: data.body, status: data.status, finalUrl: data.finalUrl || current };
    }
    return { error: "Too many redirects" };
  }

  function runValidation(html: string, pageUrlRaw: string): CheckResult[] {
    const checks: CheckResult[] = [];

    let pageUrl: URL | null = null;
    if (pageUrlRaw.trim()) {
      try {
        pageUrl = new URL(pageUrlRaw.trim());
      } catch {
        checks.push({ label: "Page URL is valid", pass: false, detail: "The Page URL field isn't a valid, absolute URL." });
        return checks;
      }
    } else {
      checks.push({
        label: "Page URL is set",
        pass: false,
        detail: "Enter this page's actual URL above so its canonical tag can be checked against it.",
      });
      return checks;
    }

    const doc = new DOMParser().parseFromString(html, "text/html");
    const canonicalEls = Array.from(doc.querySelectorAll('link[rel="canonical"]'));

    checks.push({
      label: "Exactly one canonical tag",
      pass: canonicalEls.length === 1,
      detail:
        canonicalEls.length === 0
          ? "No <link rel=\"canonical\"> tag found. Every indexable page should have exactly one."
          : canonicalEls.length === 1
            ? "Found exactly one canonical tag."
            : `Found ${canonicalEls.length} canonical tags. Google says behavior is unpredictable when more than one is present — keep only one.`,
    });

    if (canonicalEls.length === 0) return checks;

    const hrefRaw = canonicalEls[0].getAttribute("href")?.trim() || "";
    checks.push({
      label: "Canonical href is present",
      pass: !!hrefRaw,
      detail: hrefRaw ? `Found: ${hrefRaw}` : "The canonical tag has no href attribute, or it's empty.",
    });
    if (!hrefRaw) return checks;

    const isAbsolute = /^https?:\/\//i.test(hrefRaw);
    checks.push({
      label: "Canonical uses an absolute URL",
      pass: isAbsolute,
      detail: isAbsolute
        ? "The canonical URL is absolute, as recommended."
        : "The canonical URL is relative. It will still resolve, but Google recommends using a full absolute URL to avoid ambiguity.",
      severity: isAbsolute ? undefined : "info",
    });

    let canonicalUrl: URL;
    try {
      canonicalUrl = new URL(hrefRaw, pageUrl.toString());
    } catch {
      checks.push({ label: "Canonical URL is well-formed", pass: false, detail: `"${hrefRaw}" could not be parsed as a valid URL.` });
      return checks;
    }

    // Protocol
    const protocolMatch = canonicalUrl.protocol === pageUrl.protocol;
    checks.push({
      label: "Protocol matches (http vs https)",
      pass: protocolMatch,
      detail: protocolMatch
        ? `Both use ${pageUrl.protocol.replace(":", "")}.`
        : `Page is ${pageUrl.protocol.replace(":", "")}, canonical points to ${canonicalUrl.protocol.replace(":", "")}. This is a common leftover from an HTTP→HTTPS migration.`,
    });

    // Host, with a specific www-only check
    const hostMatch = canonicalUrl.host.toLowerCase() === pageUrl.host.toLowerCase();
    const pageHostNoWww = pageUrl.host.toLowerCase().replace(/^www\./, "");
    const canonicalHostNoWww = canonicalUrl.host.toLowerCase().replace(/^www\./, "");
    const wwwOnlyDifference = !hostMatch && pageHostNoWww === canonicalHostNoWww;

    checks.push({
      label: "Domain matches",
      pass: hostMatch,
      detail: hostMatch
        ? `Both use ${pageUrl.host}.`
        : wwwOnlyDifference
          ? `Page is ${pageUrl.host}, canonical points to ${canonicalUrl.host} — differs only by "www". Usually unintentional unless this is a deliberate www/non-www consolidation.`
          : `Page is ${pageUrl.host}, canonical points to a different domain entirely: ${canonicalUrl.host}. This may be intentional (e.g. syndicated content), but worth confirming.`,
      severity: hostMatch ? undefined : (wwwOnlyDifference ? undefined : "info"),
    });

    // Path
    const pagePath = stripTrailingSlash(pageUrl.pathname);
    const canonicalPath = stripTrailingSlash(canonicalUrl.pathname);
    const pathExactMatch = canonicalUrl.pathname === pageUrl.pathname;
    const pathMatchIgnoringSlash = pagePath === canonicalPath;
    const pathMatchIgnoringCase = pagePath.toLowerCase() === canonicalPath.toLowerCase();
    const canonicalIsRoot = canonicalPath === "" || canonicalPath === "/";
    const pageIsRoot = pagePath === "" || pagePath === "/";

    if (pathExactMatch) {
      checks.push({ label: "Path matches", pass: true, detail: `Both use ${pageUrl.pathname || "/"}.` });
    } else if (pathMatchIgnoringSlash) {
      checks.push({
        label: "Path matches (ignoring trailing slash)",
        pass: true,
        detail: `"${pageUrl.pathname}" vs "${canonicalUrl.pathname}" — only differ by a trailing slash, which is usually harmless.`,
        severity: "info",
      });
    } else if (canonicalIsRoot && !pageIsRoot) {
      checks.push({
        label: "Path matches",
        pass: false,
        detail: `This page is at "${pageUrl.pathname}" but its canonical points to the homepage ("${canonicalUrl.pathname || "/"}"). This is a common CMS misconfiguration that can tell search engines every page is a duplicate of the homepage — double check this is intentional.`,
      });
    } else if (pathMatchIgnoringCase) {
      checks.push({
        label: "Path matches (case differs)",
        pass: false,
        detail: `"${pageUrl.pathname}" vs "${canonicalUrl.pathname}" — same path, different letter case. URLs are case-sensitive, so this may point to a technically different resource.`,
        severity: "info",
      });
    } else {
      checks.push({
        label: "Path matches",
        pass: false,
        detail: `This page is at "${pageUrl.pathname}" but its canonical points to "${canonicalUrl.pathname}". This may be intentional (e.g. consolidating a duplicate or paginated page), but worth confirming.`,
        severity: "info",
      });
    }

    // Query (tracking-param aware)
    const pageQuery = nonTrackingQuery(pageUrl);
    const canonicalQuery = nonTrackingQuery(canonicalUrl);
    const hadTrackingParams = Array.from(pageUrl.searchParams.keys()).some((k) => TRACKING_PARAMS.has(k.toLowerCase()));

    if (pageQuery === canonicalQuery) {
      checks.push({
        label: "Query parameters match",
        pass: true,
        detail: hadTrackingParams
          ? "Tracking parameters on the page URL are correctly excluded from the canonical."
          : "No meaningful difference in query parameters.",
      });
    } else {
      checks.push({
        label: "Query parameters match",
        pass: false,
        detail: `Page has "${pageQuery || "(none)"}", canonical has "${canonicalQuery || "(none)"}" after ignoring common tracking parameters. This may be intentional if consolidating URL variants.`,
        severity: "info",
      });
    }

    // Overall self-reference verdict
    const fullyMatches =
      protocolMatch && hostMatch && (pathExactMatch || pathMatchIgnoringSlash) && pageQuery === canonicalQuery;

    checks.push({
      label: "Overall: self-referencing canonical",
      pass: fullyMatches,
      detail: fullyMatches
        ? "This page's canonical correctly points to itself."
        : "This page's canonical points elsewhere, based on the differences above. That's a valid pattern in some cases (pagination, syndication, URL consolidation) — just make sure it's intentional here.",
      severity: fullyMatches ? undefined : "info",
    });

    return checks;
  }

  function initCanonicalTagChecker(root: HTMLElement) {
    const fetchUrlInput = root.querySelector<HTMLInputElement>("[data-fetch-url-input]");
    const fetchBtn = root.querySelector<HTMLButtonElement>("[data-fetch-btn]");
    const fetchStatus = root.querySelector<HTMLElement>("[data-fetch-status]");
    const pageUrlInput = root.querySelector<HTMLInputElement>("[data-page-url-input]");
    const htmlInput = root.querySelector<HTMLTextAreaElement>("[data-html-input]");
    const report = root.querySelector<HTMLUListElement>("[data-report]");
    const reportSummary = root.querySelector<HTMLElement>("[data-report-summary]");

    if (!fetchUrlInput || !fetchBtn || !fetchStatus || !pageUrlInput || !htmlInput || !report || !reportSummary) return;

    function renderReport(checks: CheckResult[]) {
      report!.innerHTML = checks
        .map(
          (check) => `
          <li class="flex items-start gap-2">
            ${iconFor(check.pass, check.severity)}
            <div>
              <span class="font-medium text-gray-800">${escapeHtml(check.label)}</span>
              <p class="text-gray-500">${escapeHtml(check.detail)}</p>
            </div>
          </li>`
        )
        .join("");

      const failCount = checks.filter((c) => !c.pass && c.severity !== "info").length;
      reportSummary!.textContent = failCount === 0 ? "All checks passed" : `${failCount} issue${failCount === 1 ? "" : "s"} found`;
      reportSummary!.className = failCount === 0 ? "text-xs text-green-600" : "text-xs text-amber-600";
    }

    function run() {
      const html = htmlInput!.value.trim();
      if (!html) {
        report!.innerHTML = '<li class="text-gray-400">Paste HTML or fetch a URL to check its canonical tag.</li>';
        reportSummary!.textContent = "";
        return;
      }
      renderReport(runValidation(html, pageUrlInput!.value));
    }

    htmlInput.addEventListener("input", run);
    pageUrlInput.addEventListener("input", run);

    fetchBtn.addEventListener("click", async () => {
      let target = fetchUrlInput!.value.trim();
      if (!target) return;
      if (!/^https?:\/\//i.test(target)) target = "https://" + target;

      let parsedUrl: URL;
      try {
        parsedUrl = new URL(target);
      } catch {
        fetchStatus!.classList.remove("hidden");
        fetchStatus!.className = "mb-3 text-xs text-red-600";
        fetchStatus!.textContent = "That doesn't look like a valid URL.";
        return;
      }

      fetchBtn!.disabled = true;
      fetchBtn!.textContent = "Fetching…";
      fetchStatus!.classList.add("hidden");

      let result: Awaited<ReturnType<typeof fetchWithRedirects>>;
      try {
        result = await fetchWithRedirects(parsedUrl.toString());
      } catch (err) {
        fetchBtn!.disabled = false;
        fetchBtn!.textContent = "Fetch";
        fetchStatus!.classList.remove("hidden");
        fetchStatus!.className = "mb-3 text-xs text-red-600";
        fetchStatus!.textContent = `Request failed: ${err instanceof Error ? err.message : "unknown error"}`;
        return;
      }

      fetchBtn!.disabled = false;
      fetchBtn!.textContent = "Fetch";

      if ("error" in result) {
        fetchStatus!.classList.remove("hidden");
        fetchStatus!.className = "mb-3 text-xs text-red-600";
        fetchStatus!.textContent = `Could not fetch: ${result.error}`;
        return;
      }

      if (result.status >= 400) {
        fetchStatus!.classList.remove("hidden");
        fetchStatus!.className = "mb-3 text-xs text-amber-600";
        fetchStatus!.textContent = `${result.finalUrl} returned status ${result.status}.`;
        return;
      }

      pageUrlInput!.value = result.finalUrl;
      htmlInput!.value = result.body;
      fetchStatus!.classList.remove("hidden");
      fetchStatus!.className = "mb-3 text-xs text-green-600";
      fetchStatus!.textContent = `Fetched from ${result.finalUrl}`;
      run();
    });

    run();
  }

  document
    .querySelectorAll<HTMLElement>("[data-canonical-tag-checker-widget]")
    .forEach(initCanonicalTagChecker);
</script>