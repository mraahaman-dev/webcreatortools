<div class="hash-generator" data-hash-generator>
  <div class="mb-4 flex flex-wrap items-center gap-2 rounded-t-2xl border border-b-0 border-slate-200 bg-slate-50 p-3">
    <div class="flex items-center gap-1 rounded-lg border border-slate-300 bg-white p-1">
      <button type="button" data-mode-btn data-mode="text" class="mode-btn rounded-md px-3 py-1.5 text-sm font-medium bg-amber-500 text-white">
        Text
      </button>
      <button type="button" data-mode-btn data-mode="file" class="mode-btn rounded-md px-3 py-1.5 text-sm font-medium text-slate-500">
        File
      </button>
    </div>
    <button type="button" data-clear-btn
      class="ml-auto rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
      Clear
    </button>
  </div>

  <div class="border border-b-0 border-slate-200 bg-white p-4">
    <div data-text-panel>
      <textarea
        data-text-input
        spellcheck="false"
        placeholder="Type or paste text to hash..."
        class="h-32 w-full resize-y rounded-xl border border-slate-200 bg-slate-50 p-4 font-mono text-sm text-slate-800 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-100"
      ></textarea>
    </div>
    <div data-file-panel class="hidden">
      <label class="flex h-32 cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-200 bg-slate-50 text-sm text-slate-500 hover:border-amber-400">
        <span data-file-label>Click to choose a file, or drop one here</span>
        <input type="file" data-file-input class="hidden" />
      </label>
    </div>
  </div>

  <div class="space-y-3 rounded-b-2xl border border-slate-200 bg-white p-5">
    <div class="hash-row" data-hash-row="MD5">
      <div class="mb-1 flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">MD5</span>
        <button type="button" data-copy-btn data-algo="MD5" class="text-xs font-medium text-amber-600 hover:underline">Copy</button>
      </div>
      <div data-hash-output="MD5" class="break-all rounded-lg bg-slate-50 p-3 font-mono text-xs text-slate-700">—</div>
    </div>
    <div class="hash-row" data-hash-row="SHA-1">
      <div class="mb-1 flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">SHA-1</span>
        <button type="button" data-copy-btn data-algo="SHA-1" class="text-xs font-medium text-amber-600 hover:underline">Copy</button>
      </div>
      <div data-hash-output="SHA-1" class="break-all rounded-lg bg-slate-50 p-3 font-mono text-xs text-slate-700">—</div>
    </div>
    <div class="hash-row" data-hash-row="SHA-256">
      <div class="mb-1 flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">SHA-256</span>
        <button type="button" data-copy-btn data-algo="SHA-256" class="text-xs font-medium text-amber-600 hover:underline">Copy</button>
      </div>
      <div data-hash-output="SHA-256" class="break-all rounded-lg bg-slate-50 p-3 font-mono text-xs text-slate-700">—</div>
    </div>
    <div class="hash-row" data-hash-row="SHA-512">
      <div class="mb-1 flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">SHA-512</span>
        <button type="button" data-copy-btn data-algo="SHA-512" class="text-xs font-medium text-amber-600 hover:underline">Copy</button>
      </div>
      <div data-hash-output="SHA-512" class="break-all rounded-lg bg-slate-50 p-3 font-mono text-xs text-slate-700">—</div>
    </div>
  </div>

  <p class="mt-3 text-xs text-slate-400">
    Everything runs in your browser using the Web Crypto API (plus a local MD5 implementation). Nothing is uploaded.
  </p>
</div>

<script>
  // --- Minimal pure-JS MD5 (Web Crypto has no native MD5 support) ---
  function md5(input: Uint8Array): string {
    function rotl(x: number, c: number) {
      return (x << c) | (x >>> (32 - c));
    }
    const s = [
      7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14,
      20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6,
      10, 15, 21,
    ];
    const K = new Int32Array(64);
    for (let i = 0; i < 64; i++) K[i] = Math.floor(Math.abs(Math.sin(i + 1)) * 2 ** 32);

    let a0 = 0x67452301, b0 = 0xefcdab89, c0 = 0x98badcfe, d0 = 0x10325476;

    const msgLen = input.length;
    const bitLen = msgLen * 8;
    const withOne = new Uint8Array(((msgLen + 8) >> 6) * 64 + 64);
    withOne.set(input);
    withOne[msgLen] = 0x80;
    const view = new DataView(withOne.buffer);
    view.setUint32(withOne.length - 8, bitLen >>> 0, true);
    view.setUint32(withOne.length - 4, Math.floor(bitLen / 2 ** 32), true);

    for (let chunkStart = 0; chunkStart < withOne.length; chunkStart += 64) {
      const M = new Int32Array(16);
      for (let i = 0; i < 16; i++) M[i] = view.getInt32(chunkStart + i * 4, true);

      let [A, B, C, D] = [a0, b0, c0, d0];
      for (let i = 0; i < 64; i++) {
        let F = 0, g = 0;
        if (i < 16) { F = (B & C) | (~B & D); g = i; }
        else if (i < 32) { F = (D & B) | (~D & C); g = (5 * i + 1) % 16; }
        else if (i < 48) { F = B ^ C ^ D; g = (3 * i + 5) % 16; }
        else { F = C ^ (B | ~D); g = (7 * i) % 16; }
        F = (F + A + K[i] + M[g]) | 0;
        A = D; D = C; C = B;
        B = (B + rotl(F, s[i])) | 0;
      }
      a0 = (a0 + A) | 0; b0 = (b0 + B) | 0; c0 = (c0 + C) | 0; d0 = (d0 + D) | 0;
    }

    function toHexLE(n: number): string {
      const bytes = [n & 0xff, (n >>> 8) & 0xff, (n >>> 16) & 0xff, (n >>> 24) & 0xff];
      return bytes.map((b) => b.toString(16).padStart(2, "0")).join("");
    }
    return toHexLE(a0) + toHexLE(b0) + toHexLE(c0) + toHexLE(d0);
  }

  function bufferToHex(buffer: ArrayBuffer): string {
    return Array.from(new Uint8Array(buffer))
      .map((b) => b.toString(16).padStart(2, "0"))
      .join("");
  }

  function initHashGenerator(root: HTMLElement) {
    const modeBtns = root.querySelectorAll<HTMLButtonElement>("[data-mode-btn]");
    const textPanel = root.querySelector<HTMLDivElement>("[data-text-panel]")!;
    const filePanel = root.querySelector<HTMLDivElement>("[data-file-panel]")!;
    const textInput = root.querySelector<HTMLTextAreaElement>("[data-text-input]")!;
    const fileInput = root.querySelector<HTMLInputElement>("[data-file-input]")!;
    const fileLabel = root.querySelector<HTMLSpanElement>("[data-file-label]")!;
    const clearBtn = root.querySelector<HTMLButtonElement>("[data-clear-btn]")!;
    const copyBtns = root.querySelectorAll<HTMLButtonElement>("[data-copy-btn]");

    let mode: "text" | "file" = "text";
    let fileBytes: Uint8Array | null = null;

    function setMode(m: "text" | "file") {
      mode = m;
      modeBtns.forEach((btn) => {
        const active = btn.dataset.mode === m;
        btn.classList.toggle("bg-amber-500", active);
        btn.classList.toggle("text-white", active);
        btn.classList.toggle("text-slate-500", !active);
      });
      textPanel.classList.toggle("hidden", m !== "text");
      filePanel.classList.toggle("hidden", m !== "file");
      computeAll();
    }

    function setOutput(algo: string, value: string) {
      const el = root.querySelector<HTMLDivElement>(`[data-hash-output="${algo}"]`)!;
      el.textContent = value;
    }

    async function computeAll() {
      let bytes: Uint8Array;
      if (mode === "text") {
        bytes = new TextEncoder().encode(textInput.value);
      } else if (fileBytes) {
        bytes = fileBytes;
      } else {
        ["MD5", "SHA-1", "SHA-256", "SHA-512"].forEach((a) => setOutput(a, "—"));
        return;
      }

      if (bytes.length === 0) {
        ["MD5", "SHA-1", "SHA-256", "SHA-512"].forEach((a) => setOutput(a, "—"));
        return;
      }

      setOutput("MD5", md5(bytes));

      for (const algo of ["SHA-1", "SHA-256", "SHA-512"] as const) {
        const digest = await crypto.subtle.digest(algo, bytes.slice().buffer as ArrayBuffer);
        setOutput(algo, bufferToHex(digest));
      }
    }

    modeBtns.forEach((btn) => {
      btn.addEventListener("click", () => setMode(btn.dataset.mode as "text" | "file"));
    });

    textInput.addEventListener("input", () => computeAll());

    fileInput.addEventListener("change", async () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      fileLabel.textContent = file.name;
      const buffer = await file.arrayBuffer();
      fileBytes = new Uint8Array(buffer);
      computeAll();
    });

    clearBtn.addEventListener("click", () => {
      textInput.value = "";
      fileInput.value = "";
      fileBytes = null;
      fileLabel.textContent = "Click to choose a file, or drop one here";
      computeAll();
    });

    copyBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const algo = btn.dataset.algo!;
        const el = root.querySelector<HTMLDivElement>(`[data-hash-output="${algo}"]`)!;
        const text = el.textContent ?? "";
        if (!text || text === "—") return;
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = "Copy"), 1500);
      });
    });

    setMode("text");
  }

  document.querySelectorAll<HTMLElement>("[data-hash-generator]").forEach(initHashGenerator);
</script>