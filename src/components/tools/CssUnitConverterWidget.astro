      <div>
        <div class="mb-1 flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">EM</span>
          <button type="button" data-copy-btn data-target="em-output"
  class="inline-flex items-center gap-1 rounded-full border border-pink-200 bg-pink-50 px-2.5 py-1 text-xs font-medium text-pink-600 transition hover:border-pink-300 hover:bg-pink-100">
  <svg data-copy-icon class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="9" y="9" width="11" height="11" rx="2"/>
    <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
  </svg>
  <span data-copy-label>Copy</span>
</button>
        </div>
        <div data-em-output class="rounded-lg bg-slate-50 p-3 font-mono text-sm text-slate-800">—</div>
      </div>
      <div>
        <div class="mb-1 flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Percentage</span>
          <button type="button" data-copy-btn data-target="percent-output"
  class="inline-flex items-center gap-1 rounded-full border border-pink-200 bg-pink-50 px-2.5 py-1 text-xs font-medium text-pink-600 transition hover:border-pink-300 hover:bg-pink-100">
  <svg data-copy-icon class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="9" y="9" width="11" height="11" rx="2"/>
    <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
  </svg>
  <span data-copy-label>Copy</span>
</button>
        </div>
