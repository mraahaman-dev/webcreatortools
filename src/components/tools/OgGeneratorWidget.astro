---
---

<div data-og-generator-widget class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
  <!-- Inspect an existing URL -->
  <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 mb-6">
    <p class="text-sm font-semibold text-gray-800 mb-1">Inspect an existing URL</p>
    <p class="text-xs text-gray-500 mb-3">Fetch a live page and see which Open Graph and Twitter tags it already has.</p>
    <div class="flex flex-wrap items-center gap-2">
      <input
        type="text"
        data-inspect-url-input
        placeholder="https://example.com"
        spellcheck="false"
        class="min-w-0 flex-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500"
      />
      <button type="button" data-inspect-btn class="rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700 disabled:cursor-not-allowed disabled:opacity-50">
        Inspect
      </button>
    </div>
    <p data-inspect-status class="hidden mt-2 text-xs"></p>

    <div data-inspect-results class="hidden mt-3">
      <ul data-inspect-list class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white text-sm"></ul>
      <button type="button" data-use-inspected-btn class="mt-2 text-xs font-medium text-green-700 hover:underline">
        Use these values in the generator below →
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Page details -->
    <div>
      <p class="text-sm font-semibold text-gray-800 mb-3">Page details</p>

      <div class="mb-3">
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-medium text-gray-600">Title</label>
          <span data-title-count class="text-xs text-gray-400">0/60</span>
        </div>
        <input type="text" data-title-input placeholder="e.g. Best SEO Tools 2026" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500" />
      </div>

      <div class="mb-3">
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-medium text-gray-600">Description</label>
          <span data-description-count class="text-xs text-gray-400">0/155</span>
        </div>
        <textarea data-description-input rows="3" placeholder="A concise summary of the page content…" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 resize-y"></textarea>
      </div>

      <div class="mb-3">
        <label class="block text-xs font-medium text-gray-600 mb-1">Page URL</label>
        <input type="text" data-url-input placeholder="https://example.com/page" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500" />
      </div>

      <div class="mb-3">
        <label class="block text-xs font-medium text-gray-600 mb-1">Site name</label>
        <input type="text" data-sitename-input placeholder="e.g. Pixelquil" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500" />
      </div>

      <div class="mb-3">
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-medium text-gray-600">Image URL</label>
          <span class="text-xs text-gray-400">1200×630 recommended</span>
        </div>
        <input type="text" data-image-input placeholder="https://example.com/image.jpg" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500" />
      </div>

      <div class="grid grid-cols-2 gap-3 mb-3">
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Type</label>
          <select data-type-select class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500">
            <option value="website" selected>website</option>
            <option value="article">article</option>
            <option value="product">product</option>
            <option value="profile">profile</option>
            <option value="book">book</option>
            <option value="video.other">video.other</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Locale</label>
          <select data-locale-select class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500">
            <option value="en_US" selected>en_US</option>
            <option value="en_GB">en_GB</option>
            <option value="es_ES">es_ES</option>
            <option value="es_MX">es_MX</option>
            <option value="fr_FR">fr_FR</option>
            <option value="de_DE">de_DE</option>
            <option value="pt_BR">pt_BR</option>
            <option value="it_IT">it_IT</option>
            <option value="ja_JP">ja_JP</option>
            <option value="zh_CN">zh_CN</option>
            <option value="ko_KR">ko_KR</option>
          </select>
        </div>
      </div>

      <div class="mb-4">
        <label class="block text-xs font-medium text-gray-600 mb-1">Twitter / X card type</label>
        <select data-twittercard-select class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500">
          <option value="summary_large_image" selected>summary_large_image (big image)</option>
          <option value="summary">summary (small thumbnail)</option>
          <option value="app">app</option>
          <option value="player">player</option>
        </select>
      </div>

      <details class="rounded-lg border border-gray-200">
        <summary class="cursor-pointer select-none px-3 py-2 text-sm font-medium text-gray-700">Advanced options</summary>
        <div class="border-t border-gray-200 p-3 space-y-3">
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">Image alt text</label>
            <input type="text" data-image-alt-input placeholder="Describes the image for screen readers" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">twitter:site</label>
              <input type="text" data-twittersite-input placeholder="@yoursite" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500" />
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">twitter:creator</label>
              <input type="text" data-twittercreator-input placeholder="@author" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500" />
            </div>
          </div>
          <div data-published-field class="hidden">
            <label class="block text-xs font-medium text-gray-600 mb-1">Published date (article only)</label>
            <input type="date" data-published-input class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500" />
          </div>
        </div>
      </details>
    </div>

    <!-- Preview + output -->
    <div>
      <div class="flex items-center justify-between mb-2">
        <p class="text-sm font-semibold text-gray-800">Preview</p>
        <div class="flex items-center gap-1 rounded-lg bg-gray-100 p-1">
          <button type="button" data-preview-tab="facebook" class="rounded-md px-2.5 py-1 text-xs font-medium transition-colors">Facebook</button>
          <button type="button" data-preview-tab="twitter" class="rounded-md px-2.5 py-1 text-xs font-medium transition-colors">Twitter / X</button>
          <button type="button" data-preview-tab="linkedin" class="rounded-md px-2.5 py-1 text-xs font-medium transition-colors">LinkedIn</button>
        </div>
      </div>

      <div data-preview-card class="rounded-lg border border-gray-200 overflow-hidden mb-1"></div>
      <p class="text-xs text-gray-400 mb-5">Approximation only — actual rendering varies by platform and changes over time.</p>

      <div class="flex items-center justify-between mb-1">
        <p class="text-sm font-semibold text-gray-800">Generated tags</p>
        <button type="button" data-copy-btn class="inline-flex items-center gap-1.5 rounded-full bg-white border border-gray-300 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 shadow-sm transition-colors">
          <svg data-copy-icon xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <svg data-copy-check xmlns="http://www.w3.org/2000/svg" class="hidden h-3.5 w-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span data-copy-label>Copy code</span>
        </button>
      </div>
      <textarea data-output readonly rows="12" spellcheck="false" class="w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm font-mono text-gray-800 leading-relaxed focus:outline-none focus:ring-2 focus:ring-green-500 resize-y"></textarea>
    </div>
  </div>
</div>

<script>
  type PreviewTab = "facebook" | "twitter" | "linkedin";

  const OG_TAGS = ["og:title", "og:description", "og:image", "og:url", "og:type", "og:site_name", "og:locale"];
  const TWITTER_TAGS = ["twitter:card", "twitter:title", "twitter:description", "twitter:image", "twitter:site", "twitter:creator"];

  function escapeHtml(text: string): string {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  function escapeAttr(text: string): string {
    return text.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function domainFromUrl(url: string): string {
    try {
      return new URL(url).hostname.replace(/^www\./, "");
    } catch {
      return url;
    }
  }

  async function fetchWithRedirects(url: string, maxHops = 5): Promise<{ body: string; status: number; finalUrl: string } | { error: string }> {
    let current = url;
    for (let i = 0; i < maxHops; i++) {
      const res = await fetch(`/api/fetch-proxy/?url=${encodeURIComponent(current)}`);
      if (!res.ok && res.status !== 400 && res.status !== 502) {
        return { error: `/api/fetch-proxy responded with HTTP ${res.status}` };
      }
      let data: any;
      try {
        data = await res.json();
      } catch {
        return { error: "The proxy endpoint didn't return valid JSON." };
      }
      if (data.error) return { error: data.error };
      if (data.status >= 300 && data.status < 400 && data.headers?.location) {
        current = new URL(data.headers.location, current).toString();
        continue;
      }
      return { body: data.body, status: data.status, finalUrl: data.finalUrl || current };
    }
    return { error: "Too many redirects" };
  }

  function initOgGenerator(root: HTMLElement) {
    const inspectUrlInput = root.querySelector<HTMLInputElement>("[data-inspect-url-input]");
    const inspectBtn = root.querySelector<HTMLButtonElement>("[data-inspect-btn]");
    const inspectStatus = root.querySelector<HTMLElement>("[data-inspect-status]");
    const inspectResults = root.querySelector<HTMLElement>("[data-inspect-results]");
    const inspectList = root.querySelector<HTMLElement>("[data-inspect-list]");
    const useInspectedBtn = root.querySelector<HTMLButtonElement>("[data-use-inspected-btn]");

    const titleInput = root.querySelector<HTMLInputElement>("[data-title-input]");
    const titleCount = root.querySelector<HTMLElement>("[data-title-count]");
    const descriptionInput = root.querySelector<HTMLTextAreaElement>("[data-description-input]");
    const descriptionCount = root.querySelector<HTMLElement>("[data-description-count]");
    const urlInput = root.querySelector<HTMLInputElement>("[data-url-input]");
    const sitenameInput = root.querySelector<HTMLInputElement>("[data-sitename-input]");
    const imageInput = root.querySelector<HTMLInputElement>("[data-image-input]");
    const imageAltInput = root.querySelector<HTMLInputElement>("[data-image-alt-input]");
    const typeSelect = root.querySelector<HTMLSelectElement>("[data-type-select]");
    const localeSelect = root.querySelector<HTMLSelectElement>("[data-locale-select]");
    const twitterCardSelect = root.querySelector<HTMLSelectElement>("[data-twittercard-select]");
    const twitterSiteInput = root.querySelector<HTMLInputElement>("[data-twittersite-input]");
    const twitterCreatorInput = root.querySelector<HTMLInputElement>("[data-twittercreator-input]");
    const publishedField = root.querySelector<HTMLElement>("[data-published-field]");
    const publishedInput = root.querySelector<HTMLInputElement>("[data-published-input]");

    const previewTabs = root.querySelectorAll<HTMLButtonElement>("[data-preview-tab]");
    const previewCard = root.querySelector<HTMLElement>("[data-preview-card]");

    const output = root.querySelector<HTMLTextAreaElement>("[data-output]");
    const copyBtn = root.querySelector<HTMLButtonElement>("[data-copy-btn]");
    const copyIcon = root.querySelector<HTMLElement>("[data-copy-icon]");
    const copyCheck = root.querySelector<HTMLElement>("[data-copy-check]");
    const copyLabel = root.querySelector<HTMLElement>("[data-copy-label]");

    if (
      !inspectUrlInput || !inspectBtn || !inspectStatus || !inspectResults || !inspectList || !useInspectedBtn ||
      !titleInput || !titleCount || !descriptionInput || !descriptionCount || !urlInput || !sitenameInput ||
      !imageInput || !imageAltInput || !typeSelect || !localeSelect || !twitterCardSelect || !twitterSiteInput ||
      !twitterCreatorInput || !publishedField || !publishedInput || previewTabs.length === 0 || !previewCard ||
      !output || !copyBtn || !copyIcon || !copyCheck || !copyLabel
    ) {
      return;
    }

    let activeTab: PreviewTab = "facebook";
    let lastInspected: Record<string, string> = {};

    function setActiveTab() {
      previewTabs.forEach((btn) => {
        const isActive = btn.dataset.previewTab === activeTab;
        btn.className = isActive
          ? "rounded-md px-2.5 py-1 text-xs font-medium transition-colors bg-white text-green-700 shadow-sm"
          : "rounded-md px-2.5 py-1 text-xs font-medium transition-colors text-gray-500 hover:text-gray-700";
      });
    }

    function syncPublishedFieldVisibility() {
      publishedField!.classList.toggle("hidden", typeSelect!.value !== "article");
    }

    function renderPreview() {
      const title = titleInput!.value.trim() || "Your title will appear here";
      const description = descriptionInput!.value.trim() || "Your description will appear here.";
      const image = imageInput!.value.trim();
      const domain = domainFromUrl(urlInput!.value.trim() || "example.com");

      const imageBlock = image
        ? `<img src="${escapeAttr(image)}" alt="" class="w-full h-full object-cover" onerror="this.style.display='none'" />`
        : `<div class="flex h-full w-full items-center justify-center bg-gray-100 text-gray-300 text-xs">No image set</div>`;

      const compact = activeTab === "twitter" && twitterCardSelect!.value === "summary";

      if (compact) {
        previewCard!.innerHTML = `
          <div class="flex items-stretch border border-gray-200 rounded-lg overflow-hidden">
            <div class="w-20 h-20 flex-shrink-0 bg-gray-100">${imageBlock}</div>
            <div class="flex-1 min-w-0 p-2.5 flex flex-col justify-center">
              <div class="text-sm font-semibold text-gray-900 truncate">${escapeHtml(title)}</div>
              <div class="text-xs text-gray-500 line-clamp-2">${escapeHtml(description)}</div>
              <div class="text-xs text-gray-400 mt-0.5">${escapeHtml(domain)}</div>
            </div>
          </div>`;
      } else {
        previewCard!.innerHTML = `
          <div class="border border-gray-200 rounded-lg overflow-hidden">
            <div class="w-full aspect-[1200/630] bg-gray-100">${imageBlock}</div>
            <div class="p-3 bg-gray-50">
              <div class="text-xs uppercase tracking-wide text-gray-400 mb-0.5">${escapeHtml(domain)}</div>
              <div class="text-sm font-semibold text-gray-900 truncate">${escapeHtml(title)}</div>
              <div class="text-xs text-gray-500 line-clamp-2 mt-0.5">${escapeHtml(description)}</div>
            </div>
          </div>`;
      }
    }

    function renderOutput() {
      const title = titleInput!.value.trim();
      const description = descriptionInput!.value.trim();
      const url = urlInput!.value.trim();
      const siteName = sitenameInput!.value.trim();
      const image = imageInput!.value.trim();
      const imageAlt = imageAltInput!.value.trim();
      const type = typeSelect!.value;
      const locale = localeSelect!.value;
      const twitterCard = twitterCardSelect!.value;
      const twitterSite = twitterSiteInput!.value.trim();
      const twitterCreator = twitterCreatorInput!.value.trim();
      const published = publishedInput!.value.trim();

      const primary: string[] = [];
      if (title) primary.push(`<title>${escapeHtml(title)}</title>`);
      if (description) primary.push(`<meta name="description" content="${escapeAttr(description)}" />`);

      const og: string[] = [];
      if (type) og.push(`<meta property="og:type" content="${escapeAttr(type)}" />`);
      if (url) og.push(`<meta property="og:url" content="${escapeAttr(url)}" />`);
      if (title) og.push(`<meta property="og:title" content="${escapeAttr(title)}" />`);
      if (description) og.push(`<meta property="og:description" content="${escapeAttr(description)}" />`);
      if (image) og.push(`<meta property="og:image" content="${escapeAttr(image)}" />`);
      if (image && imageAlt) og.push(`<meta property="og:image:alt" content="${escapeAttr(imageAlt)}" />`);
      if (siteName) og.push(`<meta property="og:site_name" content="${escapeAttr(siteName)}" />`);
      if (locale) og.push(`<meta property="og:locale" content="${escapeAttr(locale)}" />`);
      if (type === "article" && published) og.push(`<meta property="article:published_time" content="${escapeAttr(published)}" />`);

      const twitter: string[] = [];
      if (twitterCard) twitter.push(`<meta name="twitter:card" content="${escapeAttr(twitterCard)}" />`);
      if (title) twitter.push(`<meta name="twitter:title" content="${escapeAttr(title)}" />`);
      if (description) twitter.push(`<meta name="twitter:description" content="${escapeAttr(description)}" />`);
      if (image) twitter.push(`<meta name="twitter:image" content="${escapeAttr(image)}" />`);
      if (twitterSite) twitter.push(`<meta name="twitter:site" content="${escapeAttr(twitterSite)}" />`);
      if (twitterCreator) twitter.push(`<meta name="twitter:creator" content="${escapeAttr(twitterCreator)}" />`);

      const blocks: string[] = [];
      if (primary.length) blocks.push(`<!-- Primary Meta Tags -->\n${primary.join("\n")}`);
      if (og.length) blocks.push(`<!-- Open Graph / Facebook -->\n${og.join("\n")}`);
      if (twitter.length) blocks.push(`<!-- Twitter / X -->\n${twitter.join("\n")}`);

      output!.value = blocks.join("\n\n");
    }

    function render() {
      titleCount!.textContent = `${titleInput!.value.length}/60`;
      titleCount!.className = titleInput!.value.length > 60 ? "text-xs text-amber-600" : "text-xs text-gray-400";
      descriptionCount!.textContent = `${descriptionInput!.value.length}/155`;
      descriptionCount!.className = descriptionInput!.value.length > 155 ? "text-xs text-amber-600" : "text-xs text-gray-400";

      syncPublishedFieldVisibility();
      renderPreview();
      renderOutput();
    }

    previewTabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeTab = (btn.dataset.previewTab as PreviewTab) || "facebook";
        setActiveTab();
        renderPreview();
      });
    });

    [
      titleInput, descriptionInput, urlInput, sitenameInput, imageInput, imageAltInput,
      twitterSiteInput, twitterCreatorInput, publishedInput,
    ].forEach((el) => el!.addEventListener("input", render));

    [typeSelect, localeSelect, twitterCardSelect].forEach((el) => el!.addEventListener("change", render));

    copyBtn.addEventListener("click", async () => {
      if (!output!.value) return;
      try {
        await navigator.clipboard.writeText(output!.value);
        copyIcon!.classList.add("hidden");
        copyCheck!.classList.remove("hidden");
        copyLabel!.textContent = "Copied!";
        setTimeout(() => {
          copyIcon!.classList.remove("hidden");
          copyCheck!.classList.add("hidden");
          copyLabel!.textContent = "Copy code";
        }, 1500);
      } catch {
        // clipboard write failed silently; user can still select the text manually
      }
    });

    inspectBtn.addEventListener("click", async () => {
      let target = inspectUrlInput!.value.trim();
      if (!target) return;
      if (!/^https?:\/\//i.test(target)) target = "https://" + target;

      let parsedUrl: URL;
      try {
        parsedUrl = new URL(target);
      } catch {
        inspectStatus!.classList.remove("hidden");
        inspectStatus!.className = "mt-2 text-xs text-red-600";
        inspectStatus!.textContent = "That doesn't look like a valid URL.";
        return;
      }

      inspectBtn!.disabled = true;
      inspectBtn!.textContent = "Inspecting…";
      inspectStatus!.classList.add("hidden");
      inspectResults!.classList.add("hidden");

      let result: Awaited<ReturnType<typeof fetchWithRedirects>>;
      try {
        result = await fetchWithRedirects(parsedUrl.toString());
      } catch (err) {
        inspectBtn!.disabled = false;
        inspectBtn!.textContent = "Inspect";
        inspectStatus!.classList.remove("hidden");
        inspectStatus!.className = "mt-2 text-xs text-red-600";
        inspectStatus!.textContent = `Request failed: ${err instanceof Error ? err.message : "unknown error"}`;
        return;
      }

      inspectBtn!.disabled = false;
      inspectBtn!.textContent = "Inspect";

      if ("error" in result) {
        inspectStatus!.classList.remove("hidden");
        inspectStatus!.className = "mt-2 text-xs text-red-600";
        inspectStatus!.textContent = `Could not fetch: ${result.error}`;
        return;
      }

      if (result.status >= 400) {
        inspectStatus!.classList.remove("hidden");
        inspectStatus!.className = "mt-2 text-xs text-amber-600";
        inspectStatus!.textContent = `${result.finalUrl} returned status ${result.status}.`;
        return;
      }

      const doc = new DOMParser().parseFromString(result.body, "text/html");
      const found: Record<string, string> = {};

      OG_TAGS.forEach((tag) => {
        const value = doc.querySelector(`meta[property="${tag}"]`)?.getAttribute("content")?.trim();
        if (value) found[tag] = value;
      });
      TWITTER_TAGS.forEach((tag) => {
        const value = doc.querySelector(`meta[name="${tag}"]`)?.getAttribute("content")?.trim();
        if (value) found[tag] = value;
      });

      lastInspected = found;

      const allTags = [...OG_TAGS, ...TWITTER_TAGS];
      inspectList!.innerHTML = allTags
        .map((tag) => {
          const value = found[tag];
          return `
            <li class="flex items-center justify-between gap-3 px-3 py-2 text-xs">
              <span class="font-mono text-gray-500">${tag}</span>
              <span class="flex items-center gap-1.5 ${value ? "text-gray-700" : "text-gray-400"}">
                ${value ? escapeHtml(value.length > 40 ? value.slice(0, 40) + "…" : value) : "missing"}
                ${value ? '<svg class="h-3.5 w-3.5 text-green-600" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l3.5 3.5L13 5" stroke-linecap="round" stroke-linejoin="round"/></svg>' : ""}
              </span>
            </li>`;
        })
        .join("");

      inspectStatus!.classList.remove("hidden");
      inspectStatus!.className = "mt-2 text-xs text-green-600";
      inspectStatus!.textContent = `Inspected ${result.finalUrl}`;
      inspectResults!.classList.remove("hidden");
    });

    useInspectedBtn.addEventListener("click", () => {
      if (Object.keys(lastInspected).length === 0) return;
      if (lastInspected["og:title"]) titleInput!.value = lastInspected["og:title"];
      if (lastInspected["og:description"]) descriptionInput!.value = lastInspected["og:description"];
      if (lastInspected["og:url"]) urlInput!.value = lastInspected["og:url"];
      if (lastInspected["og:site_name"]) sitenameInput!.value = lastInspected["og:site_name"];
      if (lastInspected["og:image"]) imageInput!.value = lastInspected["og:image"];
      if (lastInspected["og:type"]) typeSelect!.value = lastInspected["og:type"];
      if (lastInspected["og:locale"]) localeSelect!.value = lastInspected["og:locale"];
      if (lastInspected["twitter:card"]) twitterCardSelect!.value = lastInspected["twitter:card"];
      if (lastInspected["twitter:site"]) twitterSiteInput!.value = lastInspected["twitter:site"];
      if (lastInspected["twitter:creator"]) twitterCreatorInput!.value = lastInspected["twitter:creator"];
      render();
    });

    typeSelect.addEventListener("change", syncPublishedFieldVisibility);

    setActiveTab();
    render();
  }

  document.querySelectorAll<HTMLElement>("[data-og-generator-widget]").forEach(initOgGenerator);
</script>