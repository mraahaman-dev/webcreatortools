<div class="schema-validator" data-schema-validator>
  <div class="border border-b-0 border-slate-200 bg-white p-4">
    <div class="mb-2 flex items-center justify-between text-xs font-medium uppercase tracking-wide text-slate-500">
      <span>JSON-LD input</span>
      <span data-detected-type class="normal-case text-slate-400"></span>
    </div>
    <textarea data-json-input spellcheck="false"
      class="h-64 w-full resize-y rounded-lg border border-slate-200 bg-slate-50 p-3 font-mono text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-200"
      placeholder="Paste JSON-LD, with or without the surrounding <script> tag"
    ></textarea>
  </div>

  <div class="rounded-b-2xl border border-slate-200 bg-white p-5">
    <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Validation report</h3>
    <ul data-report class="space-y-2 text-sm"></ul>
  </div>

  <p class="mt-3 text-xs text-slate-400">
    Everything runs in your browser. Nothing you paste is uploaded or stored.
  </p>
</div>

<script>
  interface CheckResult { label: string; pass: boolean; detail: string; severity?: "warn" | "info" }

  function escapeHtml(text: string): string {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  function extractJson(raw: string): string {
    const trimmed = raw.trim();
    const scriptMatch = trimmed.match(/<script[^>]*type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/i);
    if (scriptMatch) return scriptMatch[1].trim();
    return trimmed;
  }

  function locateJsonError(text: string, err: Error): string {
    const match = err.message.match(/position (\d+)/);
    if (!match) return err.message;
    const pos = parseInt(match[1], 10);
    const before = text.slice(0, pos);
    const line = before.split("\n").length;
    const lastNewline = before.lastIndexOf("\n");
    const column = pos - lastNewline;
    return `Invalid JSON at line ${line}, column ${column}: ${err.message}`;
  }

  function isObj(v: any): v is Record<string, any> {
    return v !== null && typeof v === "object" && !Array.isArray(v);
  }

  function checkField(obj: any, field: string, label: string, results: CheckResult[], requiredType?: "string" | "object" | "array") {
    const value = obj[field];
    const present = value !== undefined && value !== null && value !== "";
    if (!present) {
      results.push({ label: `Has "${field}"`, pass: false, detail: `${label} is missing the required "${field}" property.` });
      return;
    }
    if (requiredType === "object" && !isObj(value)) {
      results.push({ label: `"${field}" is a nested object`, pass: false, detail: `"${field}" should be a nested object (with its own @type), not a plain string.` });
      return;
    }
    if (requiredType === "array" && !Array.isArray(value)) {
      results.push({ label: `"${field}" is an array`, pass: false, detail: `"${field}" should be an array of items.` });
      return;
    }
    results.push({ label: `Has "${field}"`, pass: true, detail: `Found a valid "${field}" value.` });
  }

  function validateArticle(obj: any): CheckResult[] {
    const results: CheckResult[] = [];
    checkField(obj, "headline", "Article", results);
    checkField(obj, "image", "Article", results);
    checkField(obj, "datePublished", "Article", results);
    checkField(obj, "author", "Article", results, "object");
    checkField(obj, "publisher", "Article", results, "object");

    if (isObj(obj.publisher)) {
      const hasLogo = isObj(obj.publisher.logo) && !!obj.publisher.logo.url;
      results.push({
        label: "publisher.logo is a nested ImageObject",
        pass: hasLogo,
        detail: hasLogo
          ? "publisher.logo correctly contains a nested ImageObject with a url."
          : "publisher.logo should be a nested object with @type ImageObject and a url property, not a plain string.",
      });
    }

    if (!obj.dateModified) {
      results.push({ label: "Has dateModified (recommended)", pass: false, detail: "dateModified isn't required but is recommended for content that gets updated.", severity: "info" });
    }
    return results;
  }

  function validateProduct(obj: any): CheckResult[] {
    const results: CheckResult[] = [];
    checkField(obj, "name", "Product", results);
    checkField(obj, "image", "Product", results);

    const hasOffers = isObj(obj.offers);
    results.push({
      label: "Has a nested offers object",
      pass: hasOffers,
      detail: hasOffers
        ? "offers is correctly a nested object."
        : "Product schema needs a nested offers object (type Offer) containing price and availability to be eligible for price and stock rich results.",
    });

    if (hasOffers) {
      const offer = obj.offers;
      results.push({
        label: "offers.price is set",
        pass: offer.price !== undefined && offer.price !== "",
        detail: offer.price !== undefined ? `Price found: ${offer.price}` : "offers.price is missing.",
      });
      results.push({
        label: "offers.priceCurrency is set",
        pass: !!offer.priceCurrency,
        detail: offer.priceCurrency ? `Currency: ${offer.priceCurrency}` : "offers.priceCurrency is missing, e.g. USD.",
      });
      results.push({
        label: "offers.availability is set",
        pass: !!offer.availability,
        detail: offer.availability ? `Availability: ${offer.availability}` : "offers.availability is missing, e.g. https://schema.org/InStock.",
        severity: "info",
      });
    }

    if (obj.aggregateRating) {
      const rating = obj.aggregateRating;
      const valid = isObj(rating) && rating.ratingValue !== undefined && rating.reviewCount !== undefined;
      results.push({
        label: "aggregateRating has ratingValue and reviewCount",
        pass: valid,
        detail: valid
          ? "aggregateRating is correctly structured."
          : "aggregateRating is present but missing ratingValue or reviewCount, both are required together.",
      });
    }
    return results;
  }

  function validateFAQPage(obj: any): CheckResult[] {
    const results: CheckResult[] = [];
    const hasMainEntity = Array.isArray(obj.mainEntity) && obj.mainEntity.length > 0;
    results.push({
      label: "Has a mainEntity array",
      pass: hasMainEntity,
      detail: hasMainEntity ? `Found ${obj.mainEntity.length} question(s).` : "FAQPage needs a mainEntity array containing at least one Question.",
    });

    if (hasMainEntity) {
      let allValid = true;
      obj.mainEntity.forEach((q: any, i: number) => {
        const validQ = isObj(q) && q["@type"] === "Question" && !!q.name && isObj(q.acceptedAnswer) && !!q.acceptedAnswer.text;
        if (!validQ) allValid = false;
        if (!validQ) {
          results.push({
            label: `Question ${i + 1} is correctly structured`,
            pass: false,
            detail: `Question ${i + 1} needs @type: "Question", a name, and a nested acceptedAnswer object with @type "Answer" and a text field.`,
          });
        }
      });
      if (allValid) {
        results.push({ label: "All questions correctly structured", pass: true, detail: "Every mainEntity item has a name and a properly nested acceptedAnswer." });
      }
    }
    return results;
  }

  function validateOrganization(obj: any): CheckResult[] {
    const results: CheckResult[] = [];
    checkField(obj, "name", "Organization", results);
    checkField(obj, "url", "Organization", results);
    if (!obj.logo) {
      results.push({ label: "Has logo (recommended)", pass: false, detail: "logo isn't required but is recommended for Knowledge Panel eligibility.", severity: "info" });
    }
    if (!obj.sameAs || (Array.isArray(obj.sameAs) && obj.sameAs.length === 0)) {
      results.push({ label: "Has sameAs links (recommended)", pass: false, detail: "sameAs, an array of social/official profile URLs, isn't required but helps establish entity identity.", severity: "info" });
    }
    return results;
  }

  function validateBreadcrumbList(obj: any): CheckResult[] {
    const results: CheckResult[] = [];
    const hasItems = Array.isArray(obj.itemListElement) && obj.itemListElement.length > 0;
    results.push({
      label: "Has an itemListElement array",
      pass: hasItems,
      detail: hasItems ? `Found ${obj.itemListElement.length} breadcrumb level(s).` : "BreadcrumbList needs an itemListElement array of ListItem entries.",
    });

    if (hasItems) {
      let allValid = true;
      let positionsOk = true;
      obj.itemListElement.forEach((item: any, i: number) => {
        const valid = isObj(item) && item["@type"] === "ListItem" && item.position !== undefined && !!item.name && !!item.item;
        if (!valid) allValid = false;
        if (item.position !== i + 1) positionsOk = false;
      });
      results.push({
        label: "Every item has @type, position, name, and item",
        pass: allValid,
        detail: allValid ? "All breadcrumb entries are correctly structured." : "One or more entries is missing @type: \"ListItem\", position, name, or item (the URL).",
      });
      results.push({
        label: "Positions are sequential starting from 1",
        pass: positionsOk,
        detail: positionsOk ? "Position values correctly count up from 1." : "Position values should count sequentially starting from 1, matching each item's order in the list.",
      });
    }
    return results;
  }

  function runValidation(obj: any): CheckResult[] {
    const results: CheckResult[] = [];

    const hasContext = obj["@context"] === "https://schema.org" || obj["@context"] === "http://schema.org";
    results.push({
      label: "@context is schema.org",
      pass: hasContext,
      detail: hasContext ? "@context correctly set to https://schema.org." : "@context should be set to \"https://schema.org\" for search engines to recognize this vocabulary.",
    });

    const type = obj["@type"];
    results.push({
      label: "Has @type",
      pass: !!type,
      detail: type ? `Detected type: ${type}` : "@type is required so search engines know which schema this data represents.",
    });

    if (!type) return results;

    if (type === "Article" || type === "NewsArticle" || type === "BlogPosting") {
      return results.concat(validateArticle(obj));
    }
    if (type === "Product") {
      return results.concat(validateProduct(obj));
    }
    if (type === "FAQPage") {
      return results.concat(validateFAQPage(obj));
    }
    if (type === "Organization") {
      return results.concat(validateOrganization(obj));
    }
    if (type === "BreadcrumbList") {
      return results.concat(validateBreadcrumbList(obj));
    }

    results.push({
      label: "No specific rules for this type",
      pass: true,
      detail: `"${type}" isn't one of the types this validator has detailed rules for yet. Basic JSON-LD structure looks fine, but field-level requirements for this type aren't checked here.`,
      severity: "info",
    });
    return results;
  }

  function iconFor(pass: boolean) {
    return pass
      ? '<svg class="h-4 w-4 shrink-0 text-green-600" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l3.5 3.5L13 5" stroke-linecap="round" stroke-linejoin="round"/></svg>'
      : '<svg class="h-4 w-4 shrink-0 text-amber-500" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 5v4M8 11.5v.01" stroke-linecap="round"/><circle cx="8" cy="8" r="6.5"/></svg>';
  }

  const SAMPLE_JSON_LD = `{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "How to Optimize Images for the Web",
  "image": "https://example.com/images/hero.jpg",
  "author": { "@type": "Person", "name": "Jamie Rivera" },
  "datePublished": "2026-01-15"
}`;

  function initSchemaValidator(root: HTMLElement) {
    const jsonInput = root.querySelector<HTMLTextAreaElement>("[data-json-input]")!;
    const report = root.querySelector<HTMLUListElement>("[data-report]")!;
    const detectedType = root.querySelector<HTMLSpanElement>("[data-detected-type]")!;

    jsonInput.value = SAMPLE_JSON_LD;

    function render() {
      const raw = extractJson(jsonInput.value);
      if (!raw) {
        report.innerHTML = '<li class="text-slate-400">Paste JSON-LD to see its validation report.</li>';
        detectedType.textContent = "";
        return;
      }

      let parsed: any;
      try {
        parsed = JSON.parse(raw);
      } catch (err) {
        report.innerHTML = `<li class="flex items-start gap-2">${iconFor(false)}<div><span class="font-medium text-slate-800">Valid JSON</span><p class="text-slate-500">${escapeHtml(
          locateJsonError(raw, err as Error)
        )}</p></div></li>`;
        detectedType.textContent = "";
        return;
      }

      detectedType.textContent = parsed["@type"] ? `Type: ${parsed["@type"]}` : "";

      const results = runValidation(parsed);
      report.innerHTML = results
        .map(
          (r) => `
        <li class="flex items-start gap-2">
          ${iconFor(r.pass)}
          <div>
            <span class="font-medium text-slate-800">${escapeHtml(r.label)}</span>
            <p class="text-slate-500">${escapeHtml(r.detail)}</p>
          </div>
        </li>`
        )
        .join("");
    }

    jsonInput.addEventListener("input", render);
    render();
  }

  document.querySelectorAll<HTMLElement>("[data-schema-validator]").forEach(initSchemaValidator);
</script>