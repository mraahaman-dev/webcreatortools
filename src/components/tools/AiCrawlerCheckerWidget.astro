<div class="ai-crawler-checker" data-ai-crawler-checker>
  <div class="flex flex-wrap items-center gap-2 rounded-t-2xl border border-b-0 border-slate-200 bg-slate-50 p-3">
    <input type="text" data-fetch-url-input placeholder="https://example.com" spellcheck="false"
      class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-800 focus:border-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-100" />
    <button type="button" data-fetch-btn
      class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white hover:bg-purple-700 disabled:cursor-not-allowed disabled:opacity-50">
      Fetch robots.txt
    </button>
  </div>
  <div data-fetch-status class="hidden border border-b-0 border-slate-200 bg-white p-3 text-xs"></div>

  <div class="border border-b-0 border-slate-200 bg-white p-4">
    <div class="mb-2 flex items-center justify-between text-xs font-medium uppercase tracking-wide text-slate-500">
      <span>robots.txt content</span>
    </div>
    <textarea data-robots-input spellcheck="false"
      class="h-48 w-full resize-y rounded-lg border border-slate-200 bg-slate-50 p-3 font-mono text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-purple-200"
      placeholder="Paste your robots.txt content here"
    >User-agent: *
Disallow: /admin/

User-agent: GPTBot
Disallow: /

User-agent: PerplexityBot
Allow: /

User-agent: Google-Extended
Disallow: /private/</textarea>
  </div>

  <div class="border border-b-0 border-slate-200 bg-white p-4">
    <label class="block max-w-xs">
      <span class="mb-1 block text-xs text-slate-600">URL path to check</span>
      <input type="text" data-path-input value="/" spellcheck="false"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-800 focus:border-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-100" />
    </label>
  </div>

  <div class="rounded-b-2xl border border-slate-200 bg-white p-5">
    <div data-results-grid class="grid gap-3 sm:grid-cols-2"></div>
  </div>

  <p class="mt-3 text-xs text-slate-400">
    Everything runs in your browser. Paste your robots.txt content directly, or fetch it live from a URL above.
  </p>
</div>

<script>
  interface Rule { type: "allow" | "disallow"; path: string }
  interface Group { agents: string[]; rules: Rule[] }

  const CRAWLERS = [
    { name: "GPTBot", org: "OpenAI" },
    { name: "ClaudeBot", org: "Anthropic" },
    { name: "PerplexityBot", org: "Perplexity" },
    { name: "Google-Extended", org: "Google (AI training)" },
  ];

  function parseRobotsTxt(text: string): { groups: Group[] } {
    const groups: Group[] = [];
    let currentGroup: Group | null = null;
    let lastWasAgent = false;

    text.split("\n").forEach((rawLine) => {
      const line = rawLine.split("#")[0].trim();
      if (!line) return;
      const colonIdx = line.indexOf(":");
      if (colonIdx === -1) return;
      const field = line.slice(0, colonIdx).trim().toLowerCase();
      const value = line.slice(colonIdx + 1).trim();

      if (field === "user-agent") {
        if (!currentGroup || !lastWasAgent) {
          currentGroup = { agents: [], rules: [] };
          groups.push(currentGroup);
        }
        currentGroup.agents.push(value.toLowerCase());
        lastWasAgent = true;
      } else if (field === "allow" || field === "disallow") {
        if (!currentGroup) return;
        if (field === "disallow" && value === "") return;
        currentGroup.rules.push({ type: field, path: value });
        lastWasAgent = false;
      } else {
        lastWasAgent = false;
      }
    });

    return { groups };
  }

  function patternToRegex(pattern: string): RegExp {
    let escaped = pattern.replace(/[.+^${}()|[\]\\]/g, "\\$&");
    const endsWithDollar = escaped.endsWith("\\$");
    if (endsWithDollar) escaped = escaped.slice(0, -2);
    escaped = escaped.replace(/\*/g, ".*");
    return new RegExp("^" + escaped + (endsWithDollar ? "$" : ""));
  }

  function selectGroup(groups: Group[], userAgent: string): Group | null {
    const ua = userAgent.toLowerCase();
    const exact = groups.find((g) => g.agents.includes(ua));
    if (exact) return exact;
    return groups.find((g) => g.agents.includes("*")) ?? null;
  }

  function checkPath(groups: Group[], userAgent: string, path: string) {
    const group = selectGroup(groups, userAgent);
    if (!group) return { allowed: true, matched: null as Rule | null, usedWildcard: false };

    const candidates = group.rules
      .map((r) => ({ ...r, regex: patternToRegex(r.path) }))
      .filter((r) => r.regex.test(path));

    const usedWildcard = !group.agents.includes(userAgent.toLowerCase());

    if (candidates.length === 0) return { allowed: true, matched: null as Rule | null, usedWildcard };

    candidates.sort((a, b) => {
      if (b.path.length !== a.path.length) return b.path.length - a.path.length;
      return a.type === "allow" ? -1 : b.type === "allow" ? 1 : 0;
    });

    const best = candidates[0];
    return { allowed: best.type === "allow", matched: best, usedWildcard };
  }

  async function fetchWithRedirects(url: string, maxHops = 5): Promise<{ body: string; status: number; finalUrl: string } | { error: string }> {
    let current = url;
    for (let i = 0; i < maxHops; i++) {
      const res = await fetch(`/api/fetch-proxy/?url=${encodeURIComponent(current)}`);
      const data = await res.json();
      if (data.error) return { error: data.error };
      if (data.status >= 300 && data.status < 400 && data.headers?.location) {
        current = new URL(data.headers.location, current).toString();
        continue;
      }
      return { body: data.body, status: data.status, finalUrl: data.finalUrl || current };
    }
    return { error: "Too many redirects" };
  }

  function initAiCrawlerChecker(root: HTMLElement) {
    const robotsInput = root.querySelector<HTMLTextAreaElement>("[data-robots-input]")!;
    const pathInput = root.querySelector<HTMLInputElement>("[data-path-input]")!;
    const resultsGrid = root.querySelector<HTMLDivElement>("[data-results-grid]")!;
    const fetchUrlInput = root.querySelector<HTMLInputElement>("[data-fetch-url-input]")!;
    const fetchBtn = root.querySelector<HTMLButtonElement>("[data-fetch-btn]")!;
    const fetchStatus = root.querySelector<HTMLDivElement>("[data-fetch-status]")!;

    function run() {
      const { groups } = parseRobotsTxt(robotsInput.value);
      const path = pathInput.value.trim() || "/";

      resultsGrid.innerHTML = CRAWLERS.map((crawler) => {
        const result = checkPath(groups, crawler.name, path);
        const allowed = result.allowed;

        return `
          <div class="flex items-center justify-between gap-3 rounded-lg border p-3 ${
            allowed ? "border-green-200 bg-green-50" : "border-red-200 bg-red-50"
          }">
            <div>
              <div class="text-sm font-semibold text-slate-800">${crawler.name}</div>
              <div class="text-xs text-slate-500">${crawler.org}</div>
              <div class="mt-1 text-xs ${allowed ? "text-green-600" : "text-red-600"}">
                ${
                  result.matched
                    ? `${result.usedWildcard ? "Via * group — " : ""}${result.matched.type === "allow" ? "Allow" : "Disallow"}: ${result.matched.path}`
                    : result.usedWildcard
                    ? "No specific or wildcard rule found"
                    : "No rule matched this path"
                }
              </div>
            </div>
            <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold ${
              allowed ? "bg-green-600 text-white" : "bg-red-600 text-white"
            }">
              ${allowed ? "Allowed" : "Blocked"}
            </span>
          </div>
        `;
      }).join("");
    }

    fetchBtn.addEventListener("click", async () => {
      let domain = fetchUrlInput.value.trim();
      if (!domain) return;
      if (!/^https?:\/\//i.test(domain)) domain = "https://" + domain;

      let robotsUrl: string;
      try {
        robotsUrl = new URL("/robots.txt", domain).toString();
      } catch {
        fetchStatus.classList.remove("hidden");
        fetchStatus.className = "border border-b-0 border-red-200 bg-red-50 p-3 text-xs text-red-700";
        fetchStatus.textContent = "That doesn't look like a valid URL.";
        return;
      }

      fetchBtn.disabled = true;
      fetchBtn.textContent = "Fetching...";
      fetchStatus.classList.add("hidden");

      const result = await fetchWithRedirects(robotsUrl);

      fetchBtn.disabled = false;
      fetchBtn.textContent = "Fetch robots.txt";

      if ("error" in result) {
        fetchStatus.classList.remove("hidden");
        fetchStatus.className = "border border-b-0 border-red-200 bg-red-50 p-3 text-xs text-red-700";
        fetchStatus.textContent = `Could not fetch: ${result.error}`;
        return;
      }

      fetchStatus.classList.remove("hidden");
      fetchStatus.className = "border border-b-0 border-green-200 bg-green-50 p-3 text-xs text-green-700";
      fetchStatus.textContent = result.status >= 400
        ? `${result.finalUrl} returned status ${result.status}. No robots.txt found.`
        : `Fetched from ${result.finalUrl}`;
      robotsInput.value = result.status >= 400 ? "" : result.body;
      run();
    });

    robotsInput.addEventListener("input", run);
    pathInput.addEventListener("input", run);
    run();
  }

  document.querySelectorAll<HTMLElement>("[data-ai-crawler-checker]").forEach(initAiCrawlerChecker);
</script>