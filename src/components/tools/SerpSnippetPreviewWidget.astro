---
---

<div data-serp-snippet-preview-widget class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
  <div class="flex flex-wrap items-center gap-2 mb-4">
    <input
      type="text"
      data-load-url-input
      placeholder="Load from URL https://…"
      spellcheck="false"
      class="min-w-0 flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
    />
    <button
      type="button"
      data-load-btn
      class="rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-white hover:bg-amber-700 disabled:cursor-not-allowed disabled:opacity-50"
    >
      Load
    </button>
  </div>
  <p data-load-status class="hidden mb-4 text-xs"></p>

  <div class="flex items-center gap-1 mb-4 rounded-lg bg-gray-100 p-1 w-fit">
    <button type="button" data-device-btn="desktop" class="rounded-md px-3 py-1.5 text-xs font-medium transition-colors">Desktop</button>
    <button type="button" data-device-btn="mobile" class="rounded-md px-3 py-1.5 text-xs font-medium transition-colors">Mobile</button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1">Domain</label>
      <input
        type="text"
        data-domain-input
        value="example.com"
        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
      />
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1">URL path</label>
      <input
        type="text"
        data-path-input
        value="/page-path"
        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
      />
    </div>
  </div>

  <div class="mb-4">
    <label class="block text-xs font-medium text-gray-600 mb-1">Title tag</label>
    <input
      type="text"
      data-title-input
      placeholder="Enter your title tag here"
      class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
    />
    <div class="mt-1.5 h-1.5 w-full rounded-full bg-gray-100 overflow-hidden">
      <div data-title-meter class="h-full rounded-full bg-green-500 transition-all" style="width: 0%"></div>
    </div>
    <p data-title-stats class="mt-1 text-right text-xs text-gray-500"></p>
  </div>

  <div class="mb-4">
    <label class="block text-xs font-medium text-gray-600 mb-1">Meta description</label>
    <textarea
      data-description-input
      rows="3"
      placeholder="Enter your meta description here"
      class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 resize-y"
    ></textarea>
    <div class="mt-1.5 h-1.5 w-full rounded-full bg-gray-100 overflow-hidden">
      <div data-description-meter class="h-full rounded-full bg-green-500 transition-all" style="width: 0%"></div>
    </div>
    <p data-description-stats class="mt-1 text-right text-xs text-gray-500"></p>
  </div>

  <div data-result-banner class="hidden mb-4 flex items-start gap-2 rounded-lg p-3 text-sm"></div>

  <p class="text-xs font-medium text-gray-600 mb-2">Preview</p>
  <div class="rounded-lg border border-gray-200 bg-white p-4">
    <div class="flex items-center gap-2 mb-1">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-gray-100 text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20" stroke-linecap="round"/></svg>
      </span>
      <div class="text-sm leading-tight">
        <div data-preview-domain class="text-gray-800">example.com</div>
        <div data-preview-breadcrumb class="text-xs text-gray-500"></div>
      </div>
    </div>
    <div data-preview-title class="text-[#1a0dab] text-xl leading-snug mb-0.5 truncate-none"></div>
    <div data-preview-description class="text-sm text-gray-600 leading-snug"></div>
  </div>

  <p class="mt-3 text-xs text-gray-400">
    Pixel widths are estimated from typical Google rendering (desktop title ≈600px, description ≈920px; mobile title ≈380px, description ≈680px). Google doesn't publish exact figures and these can shift over time — treat this as a strong guide, not a guarantee.
  </p>
</div>

<script>
  type Device = "desktop" | "mobile";

  const LIMITS: Record<Device, { titleFont: string; titleMax: number; descFont: string; descMax: number }> = {
    desktop: { titleFont: "20px Arial", titleMax: 600, descFont: "14px Arial", descMax: 920 },
    mobile: { titleFont: "16px Arial", titleMax: 380, descFont: "14px Arial", descMax: 680 },
  };

  function measureWidth(ctx: CanvasRenderingContext2D, text: string, font: string): number {
    ctx.font = font;
    return ctx.measureText(text).width;
  }

  function truncateToWidth(ctx: CanvasRenderingContext2D, text: string, font: string, maxWidth: number): { text: string; truncated: boolean } {
    if (measureWidth(ctx, text, font) <= maxWidth) return { text, truncated: false };

    const words = text.split(" ");
    let result = "";
    for (const word of words) {
      const candidate = (result ? result + " " : "") + word;
      if (measureWidth(ctx, candidate + "…", font) > maxWidth) break;
      result = candidate;
    }
    if (!result) {
      // Single very long word/no spaces — hard-truncate character by character.
      let chars = "";
      for (const ch of text) {
        if (measureWidth(ctx, chars + ch + "…", font) > maxWidth) break;
        chars += ch;
      }
      result = chars;
    }
    return { text: result + "…", truncated: true };
  }

  async function fetchWithRedirects(url: string, maxHops = 5): Promise<{ body: string; status: number; finalUrl: string } | { error: string }> {
    let current = url;
    for (let i = 0; i < maxHops; i++) {
      const res = await fetch(`/api/fetch-proxy/?url=${encodeURIComponent(current)}`);
      if (!res.ok && res.status !== 400 && res.status !== 502) {
        return { error: `/api/fetch-proxy responded with HTTP ${res.status}` };
      }
      let data: any;
      try {
        data = await res.json();
      } catch {
        return { error: "The proxy endpoint didn't return valid JSON." };
      }
      if (data.error) return { error: data.error };
      if (data.status >= 300 && data.status < 400 && data.headers?.location) {
        current = new URL(data.headers.location, current).toString();
        continue;
      }
      return { body: data.body, status: data.status, finalUrl: data.finalUrl || current };
    }
    return { error: "Too many redirects" };
  }

  function initSerpSnippetPreview(root: HTMLElement) {
    const loadUrlInput = root.querySelector<HTMLInputElement>("[data-load-url-input]");
    const loadBtn = root.querySelector<HTMLButtonElement>("[data-load-btn]");
    const loadStatus = root.querySelector<HTMLElement>("[data-load-status]");
    const deviceBtns = root.querySelectorAll<HTMLButtonElement>("[data-device-btn]");
    const domainInput = root.querySelector<HTMLInputElement>("[data-domain-input]");
    const pathInput = root.querySelector<HTMLInputElement>("[data-path-input]");
    const titleInput = root.querySelector<HTMLInputElement>("[data-title-input]");
    const titleMeter = root.querySelector<HTMLElement>("[data-title-meter]");
    const titleStats = root.querySelector<HTMLElement>("[data-title-stats]");
    const descriptionInput = root.querySelector<HTMLTextAreaElement>("[data-description-input]");
    const descriptionMeter = root.querySelector<HTMLElement>("[data-description-meter]");
    const descriptionStats = root.querySelector<HTMLElement>("[data-description-stats]");
    const resultBanner = root.querySelector<HTMLElement>("[data-result-banner]");
    const previewDomain = root.querySelector<HTMLElement>("[data-preview-domain]");
    const previewBreadcrumb = root.querySelector<HTMLElement>("[data-preview-breadcrumb]");
    const previewTitle = root.querySelector<HTMLElement>("[data-preview-title]");
    const previewDescription = root.querySelector<HTMLElement>("[data-preview-description]");

    if (
      !loadUrlInput || !loadBtn || !loadStatus || deviceBtns.length === 0 || !domainInput || !pathInput ||
      !titleInput || !titleMeter || !titleStats || !descriptionInput || !descriptionMeter || !descriptionStats ||
      !resultBanner || !previewDomain || !previewBreadcrumb || !previewTitle || !previewDescription
    ) {
      return;
    }

    const canvas = document.createElement("canvas");
    const ctx = canvas.getContext("2d")!;
    let device: Device = "desktop";

    function setDeviceButtons() {
      deviceBtns.forEach((btn) => {
        const isActive = btn.dataset.deviceBtn === device;
        btn.className = isActive
          ? "rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-white text-amber-700 shadow-sm"
          : "rounded-md px-3 py-1.5 text-xs font-medium transition-colors text-gray-500 hover:text-gray-700";
      });
    }

    function meterClass(ratio: number): string {
      if (ratio > 1) return "h-full rounded-full bg-red-500 transition-all";
      if (ratio > 0.92) return "h-full rounded-full bg-amber-500 transition-all";
      return "h-full rounded-full bg-green-500 transition-all";
    }

    function render() {
      const limits = LIMITS[device];
      const domain = domainInput!.value.trim() || "example.com";
      const path = pathInput!.value.trim();
      const titleRaw = titleInput!.value;
      const descriptionRaw = descriptionInput!.value;

      // Title stats + meter
      const titleWidth = measureWidth(ctx, titleRaw, limits.titleFont);
      const titleRatio = titleRaw ? titleWidth / limits.titleMax : 0;
      titleMeter!.className = meterClass(titleRatio);
      titleMeter!.style.width = `${Math.min(100, titleRatio * 100)}%`;
      titleStats!.textContent = `pixels: ${Math.round(titleWidth)} / ${limits.titleMax}, characters: ${titleRaw.length}`;

      // Description stats + meter
      const descWidth = measureWidth(ctx, descriptionRaw, limits.descFont);
      const descRatio = descriptionRaw ? descWidth / limits.descMax : 0;
      descriptionMeter!.className = meterClass(descRatio);
      descriptionMeter!.style.width = `${Math.min(100, descRatio * 100)}%`;
      descriptionStats!.textContent = `pixels: ${Math.round(descWidth)} / ${limits.descMax}, characters: ${descriptionRaw.length}`;

      // Result banner
      const titleTruncated = titleWidth > limits.titleMax;
      const descTruncated = descWidth > limits.descMax;
      resultBanner!.classList.remove("hidden");
      if (!titleRaw && !descriptionRaw) {
        resultBanner!.classList.add("hidden");
      } else if (!titleTruncated && !descTruncated) {
        resultBanner!.className = "mb-4 flex items-start gap-2 rounded-lg p-3 text-sm bg-green-50 text-green-800";
        resultBanner!.textContent = "Nice — your title and description fit without truncation on " + device + ".";
      } else {
        const parts: string[] = [];
        if (titleTruncated) parts.push("your title");
        if (descTruncated) parts.push("your description");
        resultBanner!.className = "mb-4 flex items-start gap-2 rounded-lg p-3 text-sm bg-amber-50 text-amber-800";
        resultBanner!.textContent = `Google will likely truncate ${parts.join(" and ")} on ${device}.`;
      }

      // Preview render — actually truncated to the same pixel widths, not just displayed in full.
      previewDomain!.textContent = domain;
      previewBreadcrumb!.textContent = path
        ? `${domain} › ${path.replace(/^\//, "").split("/").filter(Boolean).join(" › ")}`
        : domain;

      const titleForPreview = titleRaw || "Your title tag will appear here";
      const descForPreview = descriptionRaw || "Your meta description will appear here, showing exactly how much Google is likely to display before cutting it off.";
      previewTitle!.textContent = truncateToWidth(ctx, titleForPreview, limits.titleFont, limits.titleMax).text;
      previewDescription!.textContent = truncateToWidth(ctx, descForPreview, limits.descFont, limits.descMax).text;
    }

    deviceBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        device = (btn.dataset.deviceBtn as Device) || "desktop";
        setDeviceButtons();
        render();
      });
    });

    titleInput.addEventListener("input", render);
    descriptionInput.addEventListener("input", render);
    domainInput.addEventListener("input", render);
    pathInput.addEventListener("input", render);

    loadBtn.addEventListener("click", async () => {
      let target = loadUrlInput!.value.trim();
      if (!target) return;
      if (!/^https?:\/\//i.test(target)) target = "https://" + target;

      let parsedUrl: URL;
      try {
        parsedUrl = new URL(target);
      } catch {
        loadStatus!.classList.remove("hidden");
        loadStatus!.className = "mb-4 text-xs text-red-600";
        loadStatus!.textContent = "That doesn't look like a valid URL.";
        return;
      }

      loadBtn!.disabled = true;
      loadBtn!.textContent = "Loading…";
      loadStatus!.classList.add("hidden");

      let result: Awaited<ReturnType<typeof fetchWithRedirects>>;
      try {
        result = await fetchWithRedirects(parsedUrl.toString());
      } catch (err) {
        loadBtn!.disabled = false;
        loadBtn!.textContent = "Load";
        loadStatus!.classList.remove("hidden");
        loadStatus!.className = "mb-4 text-xs text-red-600";
        loadStatus!.textContent = `Request failed: ${err instanceof Error ? err.message : "unknown error"}`;
        return;
      }

      loadBtn!.disabled = false;
      loadBtn!.textContent = "Load";

      if ("error" in result) {
        loadStatus!.classList.remove("hidden");
        loadStatus!.className = "mb-4 text-xs text-red-600";
        loadStatus!.textContent = `Could not load: ${result.error}`;
        return;
      }

      if (result.status >= 400) {
        loadStatus!.classList.remove("hidden");
        loadStatus!.className = "mb-4 text-xs text-amber-600";
        loadStatus!.textContent = `${result.finalUrl} returned status ${result.status}.`;
        return;
      }

      const doc = new DOMParser().parseFromString(result.body, "text/html");
      const fetchedTitle = doc.querySelector("title")?.textContent?.trim() || "";
      const fetchedDescription =
        doc.querySelector('meta[name="description"]')?.getAttribute("content")?.trim() || "";

      const finalUrl = new URL(result.finalUrl);
      domainInput!.value = finalUrl.hostname;
      pathInput!.value = finalUrl.pathname;
      titleInput!.value = fetchedTitle;
      descriptionInput!.value = fetchedDescription;

      loadStatus!.classList.remove("hidden");
      loadStatus!.className = "mb-4 text-xs text-green-600";
      loadStatus!.textContent = fetchedTitle || fetchedDescription
        ? `Loaded from ${result.finalUrl}`
        : `Loaded from ${result.finalUrl}, but no <title> or meta description was found on that page.`;

      render();
    });

    setDeviceButtons();
    render();
  }

  document
    .querySelectorAll<HTMLElement>("[data-serp-snippet-preview-widget]")
    .forEach(initSerpSnippetPreview);
</script>