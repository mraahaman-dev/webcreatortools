  <p class="mt-3 rounded-b-2xl border border-slate-200 bg-white p-3 text-xs text-slate-400">
    Everything runs in your browser. Nothing you paste is uploaded or stored.
  </p>
</div>

<script>
  // Splits any reasonable input format into individual words:
  // camelCase, PascalCase, snake_case, kebab-case, CONSTANT_CASE, "Title Case", plain spaces.
  function splitWords(input: string): string[] {
    return input
      .replace(/([a-z0-9])([A-Z])/g, "$1 $2")
      .replace(/([A-Z]+)([A-Z][a-z])/g, "$1 $2")
      .replace(/[_\-]+/g, " ")
      .trim()
      .split(/\s+/)
      .filter(Boolean)
      .map((w) => w.toLowerCase());
  }

  function toCamel(words: string[]): string {
    return words
      .map((w, i) => (i === 0 ? w : w[0].toUpperCase() + w.slice(1)))
      .join("");
  }
  function toPascal(words: string[]): string {
    return words.map((w) => w[0].toUpperCase() + w.slice(1)).join("");
  }
  function toSnake(words: string[]): string {
    return words.join("_");
  }
  function toKebab(words: string[]): string {
    return words.join("-");
  }
  function toConstant(words: string[]): string {
    return words.join("_").toUpperCase();
  }
  function toTitle(words: string[]): string {
    return words.map((w) => w[0].toUpperCase() + w.slice(1)).join(" ");
  }

  function initCaseConverter(root: HTMLElement) {
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]")!;
    const clearBtn = root.querySelector<HTMLButtonElement>("[data-clear-btn]")!;
    const copyBtns = root.querySelectorAll<HTMLButtonElement>("[data-copy-btn]");

    function setOutput(caseName: string, value: string) {
      root.querySelector(`[data-output="${caseName}"]`)!.textContent = value;
    }

    function convert() {
      const lines = input.value.split("\n").map((l) => l.trim()).filter(Boolean);

      if (lines.length === 0) {
        ["camel", "pascal", "snake", "kebab", "constant", "title"].forEach((c) => setOutput(c, "—"));
        return;
      }

      const results = {
        camel: [] as string[],
        pascal: [] as string[],
        snake: [] as string[],
        kebab: [] as string[],
        constant: [] as string[],
        title: [] as string[],
      };

      for (const line of lines) {
        const words = splitWords(line);
        if (words.length === 0) continue;
        results.camel.push(toCamel(words));
        results.pascal.push(toPascal(words));
        results.snake.push(toSnake(words));
        results.kebab.push(toKebab(words));
        results.constant.push(toConstant(words));
        results.title.push(toTitle(words));
      }

      setOutput("camel", results.camel.join("\n"));
      setOutput("pascal", results.pascal.join("\n"));
      setOutput("snake", results.snake.join("\n"));
      setOutput("kebab", results.kebab.join("\n"));
      setOutput("constant", results.constant.join("\n"));
      setOutput("title", results.title.join("\n"));
    }

    input.addEventListener("input", convert);

    clearBtn.addEventListener("click", () => {
      input.value = "";
      convert();
    });

    copyBtns.forEach((btn) => {
      const icon = btn.querySelector<HTMLElement>("[data-copy-icon]")!;
      const check = btn.querySelector<HTMLElement>("[data-copy-check]")!;
      const label = btn.querySelector<HTMLElement>("[data-copy-label]")!;

      btn.addEventListener("click", async () => {
        const caseName = btn.dataset.case!;
        const text = root.querySelector(`[data-output="${caseName}"]`)!.textContent ?? "";
        if (!text || text === "—") return;

        try {
          await navigator.clipboard.writeText(text);
          icon.classList.add("hidden");
          check.classList.remove("hidden");
          label.textContent = "Copied!";
          setTimeout(() => {
            icon.classList.remove("hidden");
            check.classList.add("hidden");
            label.textContent = "Copy";
          }, 1500);
        } catch {
          // clipboard write failed silently; user can still select the text manually
        }
      });
    });

    input.value = "user_profile_settings\nMaxRetryCount\nemail-verification-token";
    convert();
  }

  document.querySelectorAll<HTMLElement>("[data-case-converter]").forEach(initCaseConverter);
</script>