<div class="color-converter" data-color-converter>
  <div class="mb-4 flex flex-wrap items-center gap-3 rounded-t-2xl border border-b-0 border-slate-200 bg-slate-50 p-3">
    <input type="color" data-color-picker value="#4f46e5"
      class="h-10 w-14 cursor-pointer rounded-lg border border-slate-300 bg-white p-1" />
    <input type="text" data-format-input value="#4f46e5" spellcheck="false"
      placeholder="Paste any color: #hex, rgb(), hsl(), oklch()..."
      class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100" />
  </div>

  <div data-parse-error class="hidden border border-b-0 border-red-200 bg-red-50 p-3 text-sm text-red-700"></div>

  <div class="grid gap-4 border border-b-0 border-slate-200 bg-white p-5 sm:grid-cols-2">
    <div class="format-row">
      <div class="mb-1 flex items-center justify-between">
        <span class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
          <span data-swatch="hex" class="h-3.5 w-3.5 shrink-0 rounded-sm border border-slate-300"></span>
          HEX
        </span>
        <button type="button" data-copy-btn data-format="hex" class="text-xs font-medium text-blue-600 hover:underline">Copy</button>
      </div>
      <div data-output="hex" class="rounded-lg bg-slate-50 p-3 font-mono text-sm text-slate-800">—</div>
    </div>
    <div class="format-row">
      <div class="mb-1 flex items-center justify-between">
        <span class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
          <span data-swatch="rgb" class="h-3.5 w-3.5 shrink-0 rounded-sm border border-slate-300"></span>
          RGB
        </span>
        <button type="button" data-copy-btn data-format="rgb" class="text-xs font-medium text-blue-600 hover:underline">Copy</button>
      </div>
      <div data-output="rgb" class="rounded-lg bg-slate-50 p-3 font-mono text-sm text-slate-800">—</div>
    </div>
    <div class="format-row">
      <div class="mb-1 flex items-center justify-between">
        <span class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
          <span data-swatch="hsl" class="h-3.5 w-3.5 shrink-0 rounded-sm border border-slate-300"></span>
          HSL
        </span>
        <button type="button" data-copy-btn data-format="hsl" class="text-xs font-medium text-blue-600 hover:underline">Copy</button>
      </div>
      <div data-output="hsl" class="rounded-lg bg-slate-50 p-3 font-mono text-sm text-slate-800">—</div>
    </div>
    <div class="format-row">
      <div class="mb-1 flex items-center justify-between">
        <span class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
          <span data-swatch="oklch" class="h-3.5 w-3.5 shrink-0 rounded-sm border border-slate-300"></span>
          OKLCH
        </span>
        <button type="button" data-copy-btn data-format="oklch" class="text-xs font-medium text-blue-600 hover:underline">Copy</button>
      </div>
      <div data-output="oklch" class="rounded-lg bg-slate-50 p-3 font-mono text-sm text-slate-800">—</div>
    </div>
  </div>

  <div class="flex items-center gap-3 rounded-b-2xl border border-slate-200 bg-white p-5">
    <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Preview</span>
    <div data-preview-swatch class="h-10 flex-1 rounded-xl border border-slate-200"></div>
  </div>

  <p class="mt-3 text-xs text-slate-400">
    Everything runs in your browser. Nothing you type is uploaded or stored.
  </p>
</div>

<script>
  // ---------- sRGB <-> HSL ----------
  function rgbToHsl(r: number, g: number, b: number): [number, number, number] {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0;
    const l = (max + min) / 2;
    const d = max - min;
    if (d !== 0) {
      s = d / (1 - Math.abs(2 * l - 1));
      switch (max) {
        case r: h = ((g - b) / d) % 6; break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h *= 60;
      if (h < 0) h += 360;
    }
    return [h, s * 100, l * 100];
  }

  function hslToRgb(h: number, s: number, l: number): [number, number, number] {
    s /= 100; l /= 100;
    const c = (1 - Math.abs(2 * l - 1)) * s;
    const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
    const m = l - c / 2;
    let [r, g, b] = [0, 0, 0];
    if (h < 60) [r, g, b] = [c, x, 0];
    else if (h < 120) [r, g, b] = [x, c, 0];
    else if (h < 180) [r, g, b] = [0, c, x];
    else if (h < 240) [r, g, b] = [0, x, c];
    else if (h < 300) [r, g, b] = [x, 0, c];
    else [r, g, b] = [c, 0, x];
    return [Math.round((r + m) * 255), Math.round((g + m) * 255), Math.round((b + m) * 255)];
  }

  // ---------- sRGB <-> OKLCH ----------
  // Based on the standard sRGB -> linear -> XYZ -> OKLab -> OKLCH pipeline.
  function srgbToLinear(c: number): number {
    c /= 255;
    return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
  }
  function linearToSrgb(c: number): number {
    const v = c <= 0.0031308 ? c * 12.92 : 1.055 * Math.pow(c, 1 / 2.4) - 0.055;
    return Math.round(Math.min(Math.max(v, 0), 1) * 255);
  }

  function rgbToOklch(r: number, g: number, b: number): [number, number, number] {
    const lr = srgbToLinear(r), lg = srgbToLinear(g), lb = srgbToLinear(b);

    const l = 0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb;
    const m = 0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb;
    const s = 0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb;

    const l_ = Math.cbrt(l), m_ = Math.cbrt(m), s_ = Math.cbrt(s);

    const L = 0.2104542553 * l_ + 0.793617785 * m_ - 0.0040720468 * s_;
    const a = 1.9779984951 * l_ - 2.428592205 * m_ + 0.4505937099 * s_;
    const bLab = 0.0259040371 * l_ + 0.7827717662 * m_ - 0.808675766 * s_;

    const C = Math.sqrt(a * a + bLab * bLab);
    let H = (Math.atan2(bLab, a) * 180) / Math.PI;
    if (H < 0) H += 360;

    return [L, C, H];
  }

  function oklchToRgb(L: number, C: number, H: number): [number, number, number] {
    const hRad = (H * Math.PI) / 180;
    const a = C * Math.cos(hRad);
    const b = C * Math.sin(hRad);

    const l_ = L + 0.3963377774 * a + 0.2158037573 * b;
    const m_ = L - 0.1055613458 * a - 0.0638541728 * b;
    const s_ = L - 0.0894841775 * a - 1.291485548 * b;

    const l = l_ ** 3, m = m_ ** 3, s = s_ ** 3;

    const lr = +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s;
    const lg = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s;
    const lb = -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s;

    return [linearToSrgb(lr), linearToSrgb(lg), linearToSrgb(lb)];
  }

  // ---------- Parsing ----------
  function clamp255(n: number) {
    return Math.min(255, Math.max(0, Math.round(n)));
  }

  function parseColor(input: string): [number, number, number] | null {
    const str = input.trim();

    const hexMatch = str.match(/^#?([0-9a-f]{3}|[0-9a-f]{6})$/i);
    if (hexMatch) {
      let hex = hexMatch[1];
      if (hex.length === 3) hex = hex.split("").map((c) => c + c).join("");
      const num = parseInt(hex, 16);
      return [(num >> 16) & 255, (num >> 8) & 255, num & 255];
    }

    const rgbMatch = str.match(/^rgba?\(\s*([\d.]+)\s*,\s*([\d.]+)\s*,\s*([\d.]+)/i);
    if (rgbMatch) {
      return [clamp255(+rgbMatch[1]), clamp255(+rgbMatch[2]), clamp255(+rgbMatch[3])];
    }

    const hslMatch = str.match(/^hsla?\(\s*([\d.]+)\s*,?\s*([\d.]+)%\s*,?\s*([\d.]+)%/i);
    if (hslMatch) {
      return hslToRgb(+hslMatch[1], +hslMatch[2], +hslMatch[3]);
    }

    const oklchMatch = str.match(/^oklch\(\s*([\d.]+)%?\s+([\d.]+)\s+([\d.]+)/i);
    if (oklchMatch) {
      const L = str.includes("%") ? +oklchMatch[1] / 100 : +oklchMatch[1];
      return oklchToRgb(L, +oklchMatch[2], +oklchMatch[3]);
    }

    return null;
  }

  function rgbToHex(r: number, g: number, b: number): string {
    return "#" + [r, g, b].map((c) => c.toString(16).padStart(2, "0")).join("");
  }

  function initColorConverter(root: HTMLElement) {
    const picker = root.querySelector<HTMLInputElement>("[data-color-picker]")!;
    const formatInput = root.querySelector<HTMLInputElement>("[data-format-input]")!;
    const parseError = root.querySelector<HTMLDivElement>("[data-parse-error]")!;
    const swatch = root.querySelector<HTMLDivElement>("[data-preview-swatch]")!;
    const copyBtns = root.querySelectorAll<HTMLButtonElement>("[data-copy-btn]");

    function setOutput(format: string, value: string) {
      root.querySelector(`[data-output="${format}"]`)!.textContent = value;
    }

    function setSwatch(format: string, hex: string) {
      const el = root.querySelector<HTMLElement>(`[data-swatch="${format}"]`);
      if (el) el.style.backgroundColor = hex;
    }

    function update(r: number, g: number, b: number, fromPicker = false) {
      parseError.classList.add("hidden");

      const hex = rgbToHex(r, g, b);
      const [h, s, l] = rgbToHsl(r, g, b);
      const [L, C, H] = rgbToOklch(r, g, b);

      setOutput("hex", hex);
      setOutput("rgb", `rgb(${r}, ${g}, ${b})`);
      setOutput("hsl", `hsl(${Math.round(h)}, ${Math.round(s)}%, ${Math.round(l)}%)`);
      setOutput("oklch", `oklch(${(L * 100).toFixed(1)}% ${C.toFixed(3)} ${H.toFixed(1)})`);

      ["hex", "rgb", "hsl", "oklch"].forEach((f) => setSwatch(f, hex));

      swatch.style.backgroundColor = hex;
      picker.value = hex;
      if (!fromPicker) formatInput.value = hex;
    }

    formatInput.addEventListener("input", () => {
      const parsed = parseColor(formatInput.value);
      if (!parsed) {
        parseError.classList.remove("hidden");
        parseError.textContent = "Could not recognize this color. Try a hex code, rgb(), hsl(), or oklch() value.";
        return;
      }
      update(parsed[0], parsed[1], parsed[2]);
    });

    picker.addEventListener("input", () => {
      const parsed = parseColor(picker.value);
      if (!parsed) return;
      update(parsed[0], parsed[1], parsed[2], true);
      formatInput.value = picker.value;
    });

    copyBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const format = btn.dataset.format!;
        const text = root.querySelector(`[data-output="${format}"]`)!.textContent ?? "";
        if (!text || text === "—") return;
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = "Copy"), 1500);
      });
    });

    update(79, 70, 229);
  }

  document.querySelectorAll<HTMLElement>("[data-color-converter]").forEach(initColorConverter);
</script>