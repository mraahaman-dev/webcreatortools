---
---

<div data-svg-to-png-batch-widget class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
  <div
    data-drop-zone
    class="flex flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 px-4 py-8 text-center cursor-pointer hover:border-blue-400 hover:bg-blue-50/40 transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M4 6h16v12H4V6z"></path>
    </svg>
    <p class="text-sm text-gray-600">
      <span class="font-semibold text-blue-600">Click to upload</span> or drag and drop multiple SVG files
    </p>
    <p class="text-xs text-gray-400">.svg files only</p>
    <input type="file" data-file-input accept=".svg,image/svg+xml" multiple class="hidden" />
  </div>

  <div data-workspace class="hidden mt-5">
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 mb-4">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Export size</label>
        <select
          data-size-preset
          class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="original">Original size</option>
          <option value="512" selected>512px</option>
          <option value="256">256px</option>
          <option value="128">128px</option>
          <option value="64">64px</option>
          <option value="32">32px</option>
          <option value="custom">Custom</option>
        </select>
      </div>

      <div data-custom-width-field class="hidden">
        <label class="block text-xs font-medium text-gray-600 mb-1">Width (px)</label>
        <input
          type="number"
          data-custom-width
          min="1"
          max="4096"
          value="512"
          class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <div data-custom-height-field class="hidden">
        <label class="block text-xs font-medium text-gray-600 mb-1">Height (px)</label>
        <input
          type="number"
          data-custom-height
          min="1"
          max="4096"
          value="512"
          class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <div class="flex items-end">
        <label class="flex items-center gap-2 text-xs text-gray-600 mb-2 select-none">
          <input type="checkbox" data-white-bg class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
          White background
        </label>
      </div>
    </div>

    <div data-file-list class="divide-y divide-gray-100 rounded-lg border border-gray-200 mb-4 max-h-64 overflow-y-auto"></div>

    <div class="flex flex-col sm:flex-row gap-2">
      <button
        type="button"
        data-convert-btn
        class="flex-1 inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 transition-colors"
      >
        Convert All
      </button>
      <button
        type="button"
        data-download-zip-btn
        disabled
        class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
      >
        Download All as ZIP
      </button>
      <button
        type="button"
        data-add-more-btn
        class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
      >
        Add More
      </button>
      <button
        type="button"
        data-clear-btn
        class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
      >
        Clear
      </button>
    </div>

    <p data-status-message class="mt-3 text-xs text-gray-500"></p>
  </div>
</div>

<script>
  import JSZip from "jszip";

  interface BatchItem {
    id: string;
    file: File;
    status: "pending" | "converting" | "done" | "error";
    pngBlob: Blob | null;
    errorMessage: string;
  }

  function parseSvgIntrinsicSize(svgText: string): { width: number; height: number } {
    try {
      const doc = new DOMParser().parseFromString(svgText, "image/svg+xml");
      const svgEl = doc.documentElement;
      if (doc.querySelector("parsererror")) throw new Error("Invalid SVG markup.");

      const widthAttr = svgEl.getAttribute("width");
      const heightAttr = svgEl.getAttribute("height");
      const w = widthAttr ? parseFloat(widthAttr) : NaN;
      const h = heightAttr ? parseFloat(heightAttr) : NaN;
      if (!isNaN(w) && !isNaN(h) && w > 0 && h > 0) return { width: w, height: h };

      const viewBox = svgEl.getAttribute("viewBox");
      if (viewBox) {
        const parts = viewBox.trim().split(/[\s,]+/).map(Number);
        if (parts.length === 4 && parts[2] > 0 && parts[3] > 0) {
          return { width: parts[2], height: parts[3] };
        }
      }

      return { width: 300, height: 150 };
    } catch {
      return { width: 300, height: 150 };
    }
  }

  function computeTargetSize(
    intrinsic: { width: number; height: number },
    preset: string,
    customWidth: number,
    customHeight: number
  ): { width: number; height: number } {
    if (preset === "custom") {
      return { width: Math.max(1, customWidth), height: Math.max(1, customHeight) };
    }
    if (preset === "original") {
      return { width: Math.round(intrinsic.width), height: Math.round(intrinsic.height) };
    }
    const maxDim = parseInt(preset, 10) || 512;
    const scale = maxDim / Math.max(intrinsic.width, intrinsic.height);
    return {
      width: Math.max(1, Math.round(intrinsic.width * scale)),
      height: Math.max(1, Math.round(intrinsic.height * scale)),
    };
  }

  function svgToPngBlob(
    svgText: string,
    targetWidth: number,
    targetHeight: number,
    whiteBackground: boolean
  ): Promise<Blob> {
    return new Promise((resolve, reject) => {
      const blob = new Blob([svgText], { type: "image/svg+xml;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const img = new Image();

      img.onload = () => {
        const canvas = document.createElement("canvas");
        canvas.width = targetWidth;
        canvas.height = targetHeight;
        const ctx = canvas.getContext("2d");
        if (!ctx) {
          URL.revokeObjectURL(url);
          reject(new Error("Canvas is not supported in this browser."));
          return;
        }
        if (whiteBackground) {
          ctx.fillStyle = "#ffffff";
          ctx.fillRect(0, 0, targetWidth, targetHeight);
        }
        ctx.drawImage(img, 0, 0, targetWidth, targetHeight);
        URL.revokeObjectURL(url);
        canvas.toBlob((pngBlob) => {
          if (pngBlob) resolve(pngBlob);
          else reject(new Error("Could not generate a PNG for this file."));
        }, "image/png");
      };

      img.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error("This file could not be parsed as a valid SVG."));
      };

      img.src = url;
    });
  }

  function downloadBlob(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  }

  function baseName(filename: string): string {
    return filename.replace(/\.svg$/i, "");
  }

  let idCounter = 0;
  function nextId(): string {
    idCounter += 1;
    return `item-${idCounter}`;
  }

  function initSvgToPngBatch(root: HTMLElement) {
    const dropZone = root.querySelector<HTMLElement>("[data-drop-zone]");
    const fileInput = root.querySelector<HTMLInputElement>("[data-file-input]");
    const workspace = root.querySelector<HTMLElement>("[data-workspace]");
    const sizePreset = root.querySelector<HTMLSelectElement>("[data-size-preset]");
    const customWidthField = root.querySelector<HTMLElement>("[data-custom-width-field]");
    const customHeightField = root.querySelector<HTMLElement>("[data-custom-height-field]");
    const customWidthInput = root.querySelector<HTMLInputElement>("[data-custom-width]");
    const customHeightInput = root.querySelector<HTMLInputElement>("[data-custom-height]");
    const whiteBgCheckbox = root.querySelector<HTMLInputElement>("[data-white-bg]");
    const fileListEl = root.querySelector<HTMLElement>("[data-file-list]");
    const convertBtn = root.querySelector<HTMLButtonElement>("[data-convert-btn]");
    const downloadZipBtn = root.querySelector<HTMLButtonElement>("[data-download-zip-btn]");
    const addMoreBtn = root.querySelector<HTMLButtonElement>("[data-add-more-btn]");
    const clearBtn = root.querySelector<HTMLButtonElement>("[data-clear-btn]");
    const statusMessage = root.querySelector<HTMLElement>("[data-status-message]");

    if (
      !dropZone || !fileInput || !workspace || !sizePreset || !customWidthField || !customHeightField ||
      !customWidthInput || !customHeightInput || !whiteBgCheckbox || !fileListEl || !convertBtn ||
      !downloadZipBtn || !addMoreBtn || !clearBtn || !statusMessage
    ) {
      return;
    }

    let items: BatchItem[] = [];

    function setStatus(message: string, isError = false) {
      statusMessage!.textContent = message;
      statusMessage!.classList.toggle("text-red-600", isError);
      statusMessage!.classList.toggle("text-gray-500", !isError);
    }

    function statusLabel(item: BatchItem): string {
      switch (item.status) {
        case "pending": return "Pending";
        case "converting": return "Converting…";
        case "done": return "Done";
        case "error": return item.errorMessage || "Error";
      }
    }

    function renderList() {
      fileListEl!.innerHTML = "";
      for (const item of items) {
        const row = document.createElement("div");
        row.className = "flex items-center justify-between gap-3 px-3 py-2 text-sm";

        const nameEl = document.createElement("span");
        nameEl.className = "truncate text-gray-700 flex-1";
        nameEl.textContent = item.file.name;

        const statusEl = document.createElement("span");
        statusEl.className =
          item.status === "error" ? "text-xs text-red-600 flex-shrink-0" :
          item.status === "done" ? "text-xs text-emerald-600 flex-shrink-0" :
          "text-xs text-gray-400 flex-shrink-0";
        statusEl.textContent = statusLabel(item);

        row.appendChild(nameEl);
        row.appendChild(statusEl);

        if (item.status === "done" && item.pngBlob) {
          const downloadLink = document.createElement("button");
          downloadLink.type = "button";
          downloadLink.className = "text-xs font-medium text-blue-600 hover:underline flex-shrink-0";
          downloadLink.textContent = "Download";
          downloadLink.addEventListener("click", () => {
            downloadBlob(item.pngBlob!, `${baseName(item.file.name)}.png`);
          });
          row.appendChild(downloadLink);
        }

        fileListEl!.appendChild(row);
      }
    }

    function addFiles(fileList: FileList | File[]) {
      const svgFiles = Array.from(fileList).filter(
        (f) => f.type === "image/svg+xml" || f.name.toLowerCase().endsWith(".svg")
      );
      if (svgFiles.length === 0) {
        setStatus("Please choose .svg files.", true);
        return;
      }
      for (const file of svgFiles) {
        items.push({ id: nextId(), file, status: "pending", pngBlob: null, errorMessage: "" });
      }
      workspace!.classList.remove("hidden");
      renderList();
      setStatus(`${items.length} file${items.length === 1 ? "" : "s"} ready to convert.`);
    }

    async function convertAll() {
      convertBtn!.disabled = true;
      downloadZipBtn!.disabled = true;
      const preset = sizePreset!.value;
      const customWidth = parseInt(customWidthInput!.value, 10) || 512;
      const customHeight = parseInt(customHeightInput!.value, 10) || 512;
      const whiteBackground = whiteBgCheckbox!.checked;

      let doneCount = 0;
      let errorCount = 0;

      for (const item of items) {
        item.status = "converting";
        renderList();
        try {
          const svgText = await item.file.text();
          const intrinsic = parseSvgIntrinsicSize(svgText);
          const target = computeTargetSize(intrinsic, preset, customWidth, customHeight);
          const pngBlob = await svgToPngBlob(svgText, target.width, target.height, whiteBackground);
          item.pngBlob = pngBlob;
          item.status = "done";
          doneCount += 1;
        } catch (err) {
          item.status = "error";
          item.errorMessage = err instanceof Error ? err.message : "Conversion failed.";
          errorCount += 1;
        }
        renderList();
      }

      convertBtn!.disabled = false;
      downloadZipBtn!.disabled = doneCount === 0;
      setStatus(
        errorCount === 0
          ? `Converted ${doneCount} file${doneCount === 1 ? "" : "s"}.`
          : `Converted ${doneCount} file${doneCount === 1 ? "" : "s"}, ${errorCount} failed.`,
        errorCount > 0
      );
    }

    async function downloadZip() {
      const doneItems = items.filter((i) => i.status === "done" && i.pngBlob);
      if (doneItems.length === 0) return;
      downloadZipBtn!.disabled = true;
      setStatus("Building ZIP…");

      try {
        const zip = new JSZip();
        for (const item of doneItems) {
          zip.file(`${baseName(item.file.name)}.png`, item.pngBlob!);
        }
        const zipBlob = await zip.generateAsync({ type: "blob" });
        downloadBlob(zipBlob, "converted-pngs.zip");
        setStatus(`Downloaded ${doneItems.length} file${doneItems.length === 1 ? "" : "s"} as ZIP.`);
      } catch {
        setStatus("Could not build the ZIP file.", true);
      } finally {
        downloadZipBtn!.disabled = false;
      }
    }

    function resetAll() {
      items = [];
      fileInput!.value = "";
      workspace!.classList.add("hidden");
      downloadZipBtn!.disabled = true;
      renderList();
      setStatus("");
    }

    dropZone.addEventListener("click", () => fileInput!.click());
    dropZone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropZone!.classList.add("border-blue-400", "bg-blue-50/40");
    });
    dropZone.addEventListener("dragleave", () => {
      dropZone!.classList.remove("border-blue-400", "bg-blue-50/40");
    });
    dropZone.addEventListener("drop", (e) => {
      e.preventDefault();
      dropZone!.classList.remove("border-blue-400", "bg-blue-50/40");
      if (e.dataTransfer?.files?.length) addFiles(e.dataTransfer.files);
    });

    fileInput.addEventListener("change", () => {
      if (fileInput!.files?.length) addFiles(fileInput!.files);
    });

    addMoreBtn.addEventListener("click", () => fileInput!.click());

    sizePreset.addEventListener("change", () => {
      const isCustom = sizePreset!.value === "custom";
      customWidthField!.classList.toggle("hidden", !isCustom);
      customHeightField!.classList.toggle("hidden", !isCustom);
    });

    convertBtn.addEventListener("click", convertAll);
    downloadZipBtn.addEventListener("click", downloadZip);
    clearBtn.addEventListener("click", resetAll);
  }

  document
    .querySelectorAll<HTMLElement>("[data-svg-to-png-batch-widget]")
    .forEach(initSvgToPngBatch);
</script>