<div class="text-diff" data-text-diff>
  <div class="mb-4 flex flex-wrap items-center gap-3 rounded-t-2xl border border-b-0 border-slate-200 bg-slate-50 p-3">
    <label class="flex items-center gap-1.5 text-sm text-slate-600">
      <input type="checkbox" data-ignore-whitespace class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-400" />
      Ignore whitespace
    </label>
    <label class="flex items-center gap-1.5 text-sm text-slate-600">
      <input type="checkbox" data-ignore-case class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-400" />
      Ignore case
    </label>
    <span data-diff-summary class="ml-auto text-xs font-medium text-slate-500"></span>
  </div>

  <div class="grid gap-0 border border-b-0 border-slate-200 bg-white sm:grid-cols-2">
    <div class="border-b border-slate-200 sm:border-b-0 sm:border-r">
      <div class="border-b border-slate-200 bg-slate-50 px-4 py-2 text-xs font-medium uppercase tracking-wide text-slate-500">
        Original
      </div>
      <textarea
        data-original-input
        spellcheck="false"
        placeholder="Paste the original text..."
        class="h-56 w-full resize-none border-0 bg-white p-4 font-mono text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-200"
      ></textarea>
    </div>
    <div>
      <div class="border-b border-slate-200 bg-slate-50 px-4 py-2 text-xs font-medium uppercase tracking-wide text-slate-500">
        Changed
      </div>
      <textarea
        data-changed-input
        spellcheck="false"
        placeholder="Paste the changed text..."
        class="h-56 w-full resize-none border-0 bg-white p-4 font-mono text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-200"
      ></textarea>
    </div>
  </div>

  <div class="rounded-b-2xl border border-slate-200 bg-white p-5">
    <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Diff</h3>
    <div data-diff-output class="overflow-auto rounded-xl border border-slate-100 font-mono text-sm">
      <div class="p-4 text-slate-400">Paste text on both sides to see the diff.</div>
    </div>
  </div>

  <p class="mt-3 text-xs text-slate-400">
    Everything runs in your browser. Neither block of text is uploaded or stored.
  </p>
</div>

<script>
  function escapeHtml(text: string): string {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  type LineOp = { type: "equal" | "add" | "remove"; text: string };

  // Standard LCS-based line diff, producing a minimal edit script.
  function diffLines(a: string[], b: string[]): LineOp[] {
    const n = a.length, m = b.length;
    const dp: number[][] = Array.from({ length: n + 1 }, () => new Array(m + 1).fill(0));

    for (let i = n - 1; i >= 0; i--) {
      for (let j = m - 1; j >= 0; j--) {
        dp[i][j] = a[i] === b[j] ? dp[i + 1][j + 1] + 1 : Math.max(dp[i + 1][j], dp[i][j + 1]);
      }
    }

    const ops: LineOp[] = [];
    let i = 0, j = 0;
    while (i < n && j < m) {
      if (a[i] === b[j]) {
        ops.push({ type: "equal", text: a[i] });
        i++; j++;
      } else if (dp[i + 1][j] >= dp[i][j + 1]) {
        ops.push({ type: "remove", text: a[i] });
        i++;
      } else {
        ops.push({ type: "add", text: b[j] });
        j++;
      }
    }
    while (i < n) ops.push({ type: "remove", text: a[i++] });
    while (j < m) ops.push({ type: "add", text: b[j++] });

    return ops;
  }

  function normalize(line: string, ignoreWhitespace: boolean, ignoreCase: boolean): string {
    let result = line;
    if (ignoreWhitespace) result = result.trim().replace(/\s+/g, " ");
    if (ignoreCase) result = result.toLowerCase();
    return result;
  }

  function renderDiff(ops: LineOp[], originalLines: string[], changedLines: string[]): string {
    let html = "";
    let lineNumA = 1, lineNumB = 1;

    ops.forEach((op) => {
      const lineNum = op.type === "remove" ? lineNumA : op.type === "add" ? lineNumB : `${lineNumA}`;
      const bg = op.type === "add" ? "bg-green-50" : op.type === "remove" ? "bg-red-50" : "bg-white";
      const marker = op.type === "add" ? "+" : op.type === "remove" ? "-" : " ";
      const markerColor = op.type === "add" ? "text-green-600" : op.type === "remove" ? "text-red-600" : "text-slate-300";
      const textColor = op.type === "add" ? "text-green-800" : op.type === "remove" ? "text-red-800" : "text-slate-700";

      const displayNum = op.type === "add" ? lineNumB : lineNumA;

      html += `<div class="flex ${bg}">
        <span class="w-10 shrink-0 select-none border-r border-slate-100 px-2 py-1 text-right text-xs text-slate-400">${displayNum}</span>
        <span class="w-4 shrink-0 select-none py-1 text-center font-bold ${markerColor}">${marker}</span>
        <span class="flex-1 whitespace-pre-wrap break-words py-1 pr-3 ${textColor}">${escapeHtml(op.text) || "&nbsp;"}</span>
      </div>`;

      if (op.type === "equal") { lineNumA++; lineNumB++; }
      else if (op.type === "add") lineNumB++;
      else lineNumA++;
    });

    return html;
  }

  function initTextDiff(root: HTMLElement) {
    const originalInput = root.querySelector<HTMLTextAreaElement>("[data-original-input]")!;
    const changedInput = root.querySelector<HTMLTextAreaElement>("[data-changed-input]")!;
    const ignoreWhitespace = root.querySelector<HTMLInputElement>("[data-ignore-whitespace]")!;
    const ignoreCase = root.querySelector<HTMLInputElement>("[data-ignore-case]")!;
    const diffOutput = root.querySelector<HTMLDivElement>("[data-diff-output]")!;
    const diffSummary = root.querySelector<HTMLSpanElement>("[data-diff-summary]")!;

    function run() {
      const originalRaw = originalInput.value;
      const changedRaw = changedInput.value;

      if (!originalRaw && !changedRaw) {
        diffOutput.innerHTML = '<div class="p-4 text-slate-400">Paste text on both sides to see the diff.</div>';
        diffSummary.textContent = "";
        return;
      }

      const originalLines = originalRaw.split("\n");
      const changedLines = changedRaw.split("\n");

      const normOriginal = originalLines.map((l) => normalize(l, ignoreWhitespace.checked, ignoreCase.checked));
      const normChanged = changedLines.map((l) => normalize(l, ignoreWhitespace.checked, ignoreCase.checked));

      // Diff on normalized lines but map back to original text for display,
      // by diffing index-paired arrays instead of the raw strings.
      const ops = diffLines(normOriginal, normChanged);

      // Re-map normalized ops back to original display text, walking pointers.
      let oi = 0, ci = 0;
      const displayOps: LineOp[] = ops.map((op) => {
        if (op.type === "equal") return { type: "equal", text: originalLines[oi++] };
        if (op.type === "remove") return { type: "remove", text: originalLines[oi++] };
        return { type: "add", text: changedLines[ci++] };
      });
      // Advance ci alongside equal ops too, since changed side also consumes a line.
      let oi2 = 0, ci2 = 0;
      const finalOps: LineOp[] = ops.map((op) => {
        if (op.type === "equal") { const t = originalLines[oi2]; oi2++; ci2++; return { type: "equal" as const, text: t }; }
        if (op.type === "remove") { const t = originalLines[oi2]; oi2++; return { type: "remove" as const, text: t }; }
        const t = changedLines[ci2]; ci2++; return { type: "add" as const, text: t };
      });

      diffOutput.innerHTML = renderDiff(finalOps, originalLines, changedLines);

      const added = finalOps.filter((o) => o.type === "add").length;
      const removed = finalOps.filter((o) => o.type === "remove").length;
      diffSummary.textContent = added === 0 && removed === 0
        ? "No differences"
        : `+${added} -${removed}`;
    }

    originalInput.addEventListener("input", run);
    changedInput.addEventListener("input", run);
    ignoreWhitespace.addEventListener("change", run);
    ignoreCase.addEventListener("change", run);

    originalInput.value = "The quick brown fox\njumps over the lazy dog\nGoodbye";
    changedInput.value = "The quick brown fox\njumps over the sleepy dog\nGoodbye for now";
    run();
  }

  document.querySelectorAll<HTMLElement>("[data-text-diff]").forEach(initTextDiff);
</script>