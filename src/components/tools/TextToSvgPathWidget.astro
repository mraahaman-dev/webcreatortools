---
---

<div data-text-to-svg-path-widget class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
  <div
    data-drop-zone
    class="flex flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 px-4 py-8 text-center cursor-pointer hover:border-blue-400 hover:bg-blue-50/40 transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M4 6h16v12H4V6z"></path>
    </svg>
    <p class="text-sm text-gray-600">
      <span class="font-semibold text-blue-600">Click to upload a font</span> or drag and drop
    </p>
    <p class="text-xs text-gray-400">.ttf, .otf, or .woff — your own font file, not bundled with this tool</p>
    <input type="file" data-font-input accept=".ttf,.otf,.woff" class="hidden" />
  </div>

  <p data-font-status class="mt-2 text-xs text-gray-500"></p>

  <div data-workspace class="hidden mt-5">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
      <div class="sm:col-span-2">
        <label class="block text-xs font-medium text-gray-600 mb-1">Text</label>
        <input
          type="text"
          data-text-input
          placeholder="Type something…"
          value="Hello"
          class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Font size</label>
        <input
          type="number"
          data-font-size-input
          min="8"
          max="1000"
          value="72"
          class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
        />
      </div>
    </div>

    <div class="flex items-center gap-2 mb-4">
      <label class="text-xs font-medium text-gray-600">Fill color</label>
      <input type="color" data-fill-color value="#111827" class="h-8 w-12 rounded border border-gray-300 cursor-pointer" />
    </div>

    <div data-preview class="flex items-center justify-center min-h-[140px] rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 mb-4">
      <p data-preview-hint class="text-sm text-gray-400">Type some text above to see it traced</p>
    </div>

    <div class="relative mb-4">
      <label class="block text-xs font-medium text-gray-600 mb-1">SVG markup</label>
      <textarea
        data-output
        readonly
        rows="6"
        spellcheck="false"
        class="w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm font-mono text-gray-800 leading-relaxed focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"
      ></textarea>
      <button
        type="button"
        data-copy-btn
        class="absolute top-8 right-2.5 inline-flex items-center gap-1.5 rounded-full bg-white border border-gray-300 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 shadow-sm transition-colors"
      >
        <svg data-copy-icon xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <svg data-copy-check xmlns="http://www.w3.org/2000/svg" class="hidden h-3.5 w-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span data-copy-label>Copy</span>
      </button>
    </div>

    <div class="flex flex-col sm:flex-row gap-2">
      <button
        type="button"
        data-download-btn
        disabled
        class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
      >
        Download SVG
      </button>
      <button
        type="button"
        data-new-font-btn
        class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
      >
        Use Different Font
      </button>
    </div>

    <p data-error-message class="mt-3 text-xs text-red-600 whitespace-pre-wrap"></p>
  </div>
</div>

<script>
  import opentype from "opentype.js";

  const DEBOUNCE_MS = 200;

  function downloadBlob(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  }

  function getFontDisplayName(font: opentype.Font, fallback: string): string {
    try {
      const name = font.getEnglishName("fullName") || font.getEnglishName("fontFamily");
      return name || fallback;
    } catch {
      return fallback;
    }
  }

  function initTextToSvgPath(root: HTMLElement) {
    const dropZone = root.querySelector<HTMLElement>("[data-drop-zone]");
    const fontInput = root.querySelector<HTMLInputElement>("[data-font-input]");
    const fontStatus = root.querySelector<HTMLElement>("[data-font-status]");
    const workspace = root.querySelector<HTMLElement>("[data-workspace]");
    const textInput = root.querySelector<HTMLInputElement>("[data-text-input]");
    const fontSizeInput = root.querySelector<HTMLInputElement>("[data-font-size-input]");
    const fillColorInput = root.querySelector<HTMLInputElement>("[data-fill-color]");
    const preview = root.querySelector<HTMLElement>("[data-preview]");
    const previewHint = root.querySelector<HTMLElement>("[data-preview-hint]");
    const output = root.querySelector<HTMLTextAreaElement>("[data-output]");
    const copyBtn = root.querySelector<HTMLButtonElement>("[data-copy-btn]");
    const copyIcon = root.querySelector<HTMLElement>("[data-copy-icon]");
    const copyCheck = root.querySelector<HTMLElement>("[data-copy-check]");
    const copyLabel = root.querySelector<HTMLElement>("[data-copy-label]");
    const downloadBtn = root.querySelector<HTMLButtonElement>("[data-download-btn]");
    const newFontBtn = root.querySelector<HTMLButtonElement>("[data-new-font-btn]");
    const errorMessage = root.querySelector<HTMLElement>("[data-error-message]");

    if (
      !dropZone || !fontInput || !fontStatus || !workspace || !textInput || !fontSizeInput || !fillColorInput ||
      !preview || !previewHint || !output || !copyBtn || !copyIcon || !copyCheck || !copyLabel ||
      !downloadBtn || !newFontBtn || !errorMessage
    ) {
      return;
    }

    let loadedFont: opentype.Font | null = null;
    let lastSvgMarkup = "";
    let debounceTimer: number | undefined;

    function setError(message: string) {
      errorMessage!.textContent = message;
    }

    async function handleFontFile(file: File) {
      setError("");
      fontStatus!.textContent = "Loading font…";
      try {
        const buffer = await file.arrayBuffer();
        const font = opentype.parse(buffer);
        if (!font.supported) {
          throw new Error("This font's format isn't supported. Try a different .ttf, .otf, or .woff file.");
        }
        loadedFont = font;
        fontStatus!.textContent = `Loaded: ${getFontDisplayName(font, file.name)} (${font.glyphs.length} glyphs)`;
        workspace!.classList.remove("hidden");
        convert();
      } catch (err) {
        loadedFont = null;
        workspace!.classList.add("hidden");
        fontStatus!.textContent = "";
        setError(err instanceof Error ? err.message : "Could not read this font file.");
      }
    }

    function convert() {
      setError("");
      if (!loadedFont) return;

      const text = textInput!.value;
      if (!text.trim()) {
        preview!.innerHTML = "";
        preview!.appendChild(previewHint!);
        output!.value = "";
        downloadBtn!.disabled = true;
        lastSvgMarkup = "";
        return;
      }

      const fontSize = Math.max(8, Math.min(1000, parseInt(fontSizeInput!.value, 10) || 72));
      const fillColor = fillColorInput!.value || "#111827";

      try {
        const path = loadedFont.getPath(text, 0, 0, fontSize);
        const bbox = path.getBoundingBox();
        const width = bbox.x2 - bbox.x1;
        const height = bbox.y2 - bbox.y1;

        if (!(width > 0) || !(height > 0)) {
          preview!.innerHTML = "";
          preview!.appendChild(previewHint!);
          previewHint!.textContent = "This font has no visible glyphs for that text.";
          output!.value = "";
          downloadBtn!.disabled = true;
          lastSvgMarkup = "";
          return;
        }

        const padding = Math.max(2, fontSize * 0.04);
        const vbX = (bbox.x1 - padding).toFixed(2);
        const vbY = (bbox.y1 - padding).toFixed(2);
        const vbW = (width + padding * 2).toFixed(2);
        const vbH = (height + padding * 2).toFixed(2);
        const dAttr = path.toPathData(2);

        const svgMarkup = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${vbX} ${vbY} ${vbW} ${vbH}">\n  <path d="${dAttr}" fill="${fillColor}" />\n</svg>`;

        preview!.innerHTML = svgMarkup;
        const svgEl = preview!.querySelector("svg");
        if (svgEl) {
          svgEl.style.width = "100%";
          svgEl.style.height = "auto";
          svgEl.style.maxHeight = "160px";
        }

        output!.value = svgMarkup;
        lastSvgMarkup = svgMarkup;
        downloadBtn!.disabled = false;
      } catch (err) {
        setError(err instanceof Error ? err.message : "Could not trace this text.");
        downloadBtn!.disabled = true;
        lastSvgMarkup = "";
      }
    }

    function scheduleConvert() {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(convert, DEBOUNCE_MS);
    }

    dropZone.addEventListener("click", () => fontInput!.click());
    dropZone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropZone!.classList.add("border-blue-400", "bg-blue-50/40");
    });
    dropZone.addEventListener("dragleave", () => {
      dropZone!.classList.remove("border-blue-400", "bg-blue-50/40");
    });
    dropZone.addEventListener("drop", (e) => {
      e.preventDefault();
      dropZone!.classList.remove("border-blue-400", "bg-blue-50/40");
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFontFile(file);
    });

    fontInput.addEventListener("change", () => {
      const file = fontInput!.files?.[0];
      if (file) handleFontFile(file);
    });

    newFontBtn.addEventListener("click", () => {
      loadedFont = null;
      fontInput!.value = "";
      workspace!.classList.add("hidden");
      fontStatus!.textContent = "";
      setError("");
    });

    textInput.addEventListener("input", scheduleConvert);
    fontSizeInput.addEventListener("input", scheduleConvert);
    fillColorInput.addEventListener("input", convert);

    copyBtn.addEventListener("click", async () => {
      if (!lastSvgMarkup) return;
      try {
        await navigator.clipboard.writeText(lastSvgMarkup);
        copyIcon!.classList.add("hidden");
        copyCheck!.classList.remove("hidden");
        copyLabel!.textContent = "Copied!";
        setTimeout(() => {
          copyIcon!.classList.remove("hidden");
          copyCheck!.classList.add("hidden");
          copyLabel!.textContent = "Copy";
        }, 1500);
      } catch {
        // clipboard write failed silently; user can still select the text manually
      }
    });

    downloadBtn.addEventListener("click", () => {
      if (!lastSvgMarkup) return;
      downloadBlob(new Blob([lastSvgMarkup], { type: "image/svg+xml" }), "text-to-path.svg");
    });
  }

  document
    .querySelectorAll<HTMLElement>("[data-text-to-svg-path-widget]")
    .forEach(initTextToSvgPath);
</script>