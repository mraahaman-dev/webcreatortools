<div class="svg-optimizer" data-svg-optimizer>
  <div class="mb-4 flex flex-wrap items-center gap-2 rounded-t-2xl border border-b-0 border-slate-200 bg-slate-50 p-3">
    <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-indigo-400">
      Upload SVG
      <input type="file" accept=".svg,image/svg+xml" data-file-input class="hidden" />
    </label>
    <button type="button" data-clear-btn class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
      Clear
    </button>

    <div class="ml-auto flex flex-wrap items-center gap-3 text-xs text-slate-600">
      <label class="flex items-center gap-1.5"><input type="checkbox" data-opt="comments" checked class="rounded border-slate-300 text-indigo-600" /> Strip comments</label>
      <label class="flex items-center gap-1.5"><input type="checkbox" data-opt="metadata" checked class="rounded border-slate-300 text-indigo-600" /> Strip editor metadata</label>
      <label class="flex items-center gap-1.5"><input type="checkbox" data-opt="empty" checked class="rounded border-slate-300 text-indigo-600" /> Remove empty groups</label>
      <label class="flex items-center gap-1.5"><input type="checkbox" data-opt="whitespace" checked class="rounded border-slate-300 text-indigo-600" /> Collapse whitespace</label>
      <label class="flex items-center gap-1.5"><input type="checkbox" data-opt="precision" checked class="rounded border-slate-300 text-indigo-600" /> Round decimals (2dp)</label>
    </div>
  </div>

  <div class="grid overflow-hidden border border-b-0 border-slate-200 md:grid-cols-2">
    <div class="border-b border-slate-200 md:border-b-0 md:border-r">
      <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2 text-xs font-medium uppercase tracking-wide text-slate-500">
        <span>Original</span>
        <span data-original-size>—</span>
      </div>
      <textarea data-original-input spellcheck="false" placeholder="Paste your SVG code here, or upload a file above"
        class="h-72 w-full resize-none border-0 bg-white p-4 font-mono text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-200"
      ><svg xmlns="http://www.w3.org/2000/svg" xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape" viewBox="0 0 48 48">
  <!-- generated by design tool -->
  <metadata>some editor metadata</metadata>
  <g id="layer1" inkscape:label="Layer 1">
    <g>
      <path d="M6.123456 38.987654 L18.000001 14.500000 L28.333333 30.111111 L34.500000 20.250000 L42.750000 38.000000 Z" fill="#4F46E5" stroke="#4F46E5" stroke-width="2.000000"/>
    </g>
    <g></g>
  </g>
</svg></textarea>
    </div>
    <div>
      <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2 text-xs font-medium uppercase tracking-wide text-slate-500">
        <span>Optimized</span>
        <span data-optimized-size>—</span>
      </div>
      <textarea data-optimized-output spellcheck="false" readonly
        class="h-72 w-full resize-none border-0 bg-slate-50 p-4 font-mono text-sm text-slate-800 focus:outline-none"
      ></textarea>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3 rounded-b-2xl border border-slate-200 bg-white p-4">
    <span data-savings class="text-sm font-medium text-green-600"></span>
    <div class="ml-auto flex gap-2">
      <button type="button" data-copy-btn class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">Copy Optimized SVG</button>
      <button type="button" data-download-btn class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Download</button>
    </div>
  </div>

  <p class="mt-3 text-xs text-slate-400">
    Everything runs in your browser. Nothing you paste is uploaded or stored.
  </p>
</div>

<script>
  const EDITOR_NAMESPACE_ATTRS = ["inkscape", "sodipodi", "dc", "cc", "rdf"];
  // Matched against each element's localName (lowercase), not a CSS selector string,
  // since names like "sodipodi:namedview" contain a colon that querySelectorAll
  // would misinterpret as a pseudo-class and throw a SyntaxError on.
  const EDITOR_LOCAL_NAMES = ["metadata", "namedview", "rdf", "work"];

  function stripComments(svg: string): string {
    return svg.replace(/<!--[\s\S]*?-->/g, "");
  }

  function roundPrecision(svg: string, decimals = 2): string {
    // Rounds any standalone decimal number (in path data, coordinates, etc.)
    return svg.replace(/-?\d+\.\d+/g, (match) => {
      const num = parseFloat(match);
      const rounded = Math.round(num * 10 ** decimals) / 10 ** decimals;
      return String(rounded);
    });
  }

  function collapseWhitespace(svg: string): string {
    return svg
      .replace(/>\s+</g, "><")
      .replace(/\s{2,}/g, " ")
      .trim();
  }

  function stripMetadataAndEmptyGroups(
    svg: string,
    stripMetadata: boolean,
    stripEmpty: boolean
  ): { result: string; error: string | null } {
    const parser = new DOMParser();
    const doc = parser.parseFromString(svg, "image/svg+xml");
    if (doc.querySelector("parsererror")) {
      return { result: svg, error: "Could not parse this as valid XML, skipping DOM-based cleanup steps." };
    }

    if (stripMetadata) {
      Array.from(doc.querySelectorAll("*")).forEach((el) => {
        if (EDITOR_LOCAL_NAMES.includes(el.localName.toLowerCase())) el.remove();
      });
      // Strip editor-specific namespace attributes from every element.
      // Strip editor-specific namespace attributes from every element.
      doc.querySelectorAll("*").forEach((el) => {
        Array.from(el.attributes).forEach((attr) => {
          const prefix = attr.name.split(":")[0];
          if (EDITOR_NAMESPACE_ATTRS.includes(prefix)) el.removeAttribute(attr.name);
        });
      });
      // Strip unused xmlns: declarations for those same editor namespaces.
      const root = doc.documentElement;
      Array.from(root.attributes).forEach((attr) => {
        if (attr.name.startsWith("xmlns:")) {
          const prefix = attr.name.split(":")[1];
          if (EDITOR_NAMESPACE_ATTRS.includes(prefix)) root.removeAttribute(attr.name);
        }
      });
    }

    if (stripEmpty) {
      // Repeatedly remove empty <g> elements (no children, no meaningful attributes)
      // since removing one empty group can expose a now-empty parent group.
      let changed = true;
      while (changed) {
        changed = false;
        doc.querySelectorAll("g").forEach((g) => {
          const hasChildren = g.children.length > 0;
          const meaningfulAttrs = Array.from(g.attributes).filter(
            (a) => !["id"].includes(a.name)
          );
          if (!hasChildren && meaningfulAttrs.length === 0) {
            g.remove();
            changed = true;
          }
        });
      }
    }

    const serializer = new XMLSerializer();
    return { result: serializer.serializeToString(doc.documentElement), error: null };
  }

  function optimize(svg: string, opts: Record<string, boolean>): { result: string; warning: string | null } {
    let result = svg;
    let warning: string | null = null;

    if (opts.comments) result = stripComments(result);

    if (opts.metadata || opts.empty) {
      const domResult = stripMetadataAndEmptyGroups(result, opts.metadata, opts.empty);
      result = domResult.result;
      warning = domResult.error;
    }

    if (opts.precision) result = roundPrecision(result, 2);
    if (opts.whitespace) result = collapseWhitespace(result);

    return { result, warning };
  }

  function byteSize(str: string): number {
    return new Blob([str]).size;
  }

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    return `${(bytes / 1024).toFixed(2)} KB`;
  }

  function initSvgOptimizer(root: HTMLElement) {
    const fileInput = root.querySelector<HTMLInputElement>("[data-file-input]")!;
    const originalInput = root.querySelector<HTMLTextAreaElement>("[data-original-input]")!;
    const optimizedOutput = root.querySelector<HTMLTextAreaElement>("[data-optimized-output]")!;
    const originalSize = root.querySelector<HTMLSpanElement>("[data-original-size]")!;
    const optimizedSize = root.querySelector<HTMLSpanElement>("[data-optimized-size]")!;
    const savings = root.querySelector<HTMLSpanElement>("[data-savings]")!;
    const clearBtn = root.querySelector<HTMLButtonElement>("[data-clear-btn]")!;
    const copyBtn = root.querySelector<HTMLButtonElement>("[data-copy-btn]")!;
    const downloadBtn = root.querySelector<HTMLButtonElement>("[data-download-btn]")!;

    function getOpts(): Record<string, boolean> {
      const opts: Record<string, boolean> = {};
      root.querySelectorAll<HTMLInputElement>("[data-opt]").forEach((el) => {
        opts[el.dataset.opt!] = el.checked;
      });
      return opts;
    }

    function run() {
      const code = originalInput.value;
      if (!code.trim()) {
        optimizedOutput.value = "";
        originalSize.textContent = "—";
        optimizedSize.textContent = "—";
        savings.textContent = "";
        return;
      }

      const { result } = optimize(code, getOpts());
      optimizedOutput.value = result;

      const origBytes = byteSize(code);
      const optBytes = byteSize(result);
      originalSize.textContent = formatBytes(origBytes);
      optimizedSize.textContent = formatBytes(optBytes);

      if (origBytes > 0) {
        const pct = ((1 - optBytes / origBytes) * 100).toFixed(1);
        savings.textContent = optBytes < origBytes ? `${pct}% smaller` : "No further reduction found";
      }
    }

    originalInput.addEventListener("input", run);
    root.querySelectorAll<HTMLInputElement>("[data-opt]").forEach((el) => el.addEventListener("change", run));

    fileInput.addEventListener("change", () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        originalInput.value = String(reader.result ?? "");
        run();
      };
      reader.readAsText(file);
    });

    clearBtn.addEventListener("click", () => {
      originalInput.value = "";
      run();
    });

    copyBtn.addEventListener("click", async () => {
      if (!optimizedOutput.value) return;
      await navigator.clipboard.writeText(optimizedOutput.value);
      copyBtn.textContent = "Copied!";
      setTimeout(() => (copyBtn.textContent = "Copy Optimized SVG"), 1500);
    });

    downloadBtn.addEventListener("click", () => {
      if (!optimizedOutput.value) return;
      const blob = new Blob([optimizedOutput.value], { type: "image/svg+xml" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "optimized.svg";
      a.click();
      URL.revokeObjectURL(url);
    });

    run();
  }

  document.querySelectorAll<HTMLElement>("[data-svg-optimizer]").forEach(initSvgOptimizer);
</script>