<div class="password-generator" data-password-generator>
  <div class="mb-4 flex items-center gap-1 rounded-t-2xl border border-b-0 border-slate-200 bg-slate-50 p-3">
    <button type="button" data-mode-btn data-mode="password" class="mode-btn rounded-md px-3 py-1.5 text-sm font-medium bg-blue-600 text-white">
      Random Password
    </button>
    <button type="button" data-mode-btn data-mode="passphrase" class="mode-btn rounded-md px-3 py-1.5 text-sm font-medium text-slate-500">
      Passphrase
    </button>
  </div>

  <div class="border border-b-0 border-slate-200 bg-white p-5">
    <div data-password-panel class="space-y-4">
      <label class="block">
        <div class="mb-1 flex items-center justify-between text-sm text-slate-600">
          <span>Length</span>
          <span data-length-value class="font-mono font-medium text-slate-800">16</span>
        </div>
        <input type="range" data-length-input min="6" max="64" value="16" class="w-full accent-blue-600" />
      </label>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <label class="flex items-center gap-1.5 text-sm text-slate-600">
          <input type="checkbox" data-opt="uppercase" checked class="rounded border-slate-300 text-blue-600 focus:ring-blue-400" />
          A-Z
        </label>
        <label class="flex items-center gap-1.5 text-sm text-slate-600">
          <input type="checkbox" data-opt="lowercase" checked class="rounded border-slate-300 text-blue-600 focus:ring-blue-400" />
          a-z
        </label>
        <label class="flex items-center gap-1.5 text-sm text-slate-600">
          <input type="checkbox" data-opt="numbers" checked class="rounded border-slate-300 text-blue-600 focus:ring-blue-400" />
          0-9
        </label>
        <label class="flex items-center gap-1.5 text-sm text-slate-600">
          <input type="checkbox" data-opt="symbols" checked class="rounded border-slate-300 text-blue-600 focus:ring-blue-400" />
          !@#$
        </label>
      </div>
      <label class="flex items-center gap-1.5 text-sm text-slate-600">
        <input type="checkbox" data-opt="excludeAmbiguous" class="rounded border-slate-300 text-blue-600 focus:ring-blue-400" />
        Exclude ambiguous characters (l, 1, I, O, 0)
      </label>
    </div>

    <div data-passphrase-panel class="hidden space-y-4">
      <label class="block">
        <div class="mb-1 flex items-center justify-between text-sm text-slate-600">
          <span>Word count</span>
          <span data-word-count-value class="font-mono font-medium text-slate-800">4</span>
        </div>
        <input type="range" data-word-count-input min="3" max="8" value="4" class="w-full accent-blue-600" />
      </label>
      <label class="flex items-center gap-1.5 text-sm text-slate-600">
        <input type="text" data-separator-input value="-" maxlength="3"
          class="w-16 rounded-lg border border-slate-300 bg-white px-2 py-1 text-center font-mono text-sm text-slate-800 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100" />
        Separator
      </label>
      <label class="flex items-center gap-1.5 text-sm text-slate-600">
        <input type="checkbox" data-opt="includeNumber" class="rounded border-slate-300 text-blue-600 focus:ring-blue-400" />
        Include a random number
      </label>
      <label class="flex items-center gap-1.5 text-sm text-slate-600">
        <input type="checkbox" data-opt="capitalize" checked class="rounded border-slate-300 text-blue-600 focus:ring-blue-400" />
        Capitalize each word
      </label>
    </div>
  </div>

  <div class="rounded-b-2xl border border-slate-200 bg-white p-5">
    <div class="mb-3 flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 p-4">
      <span data-output class="flex-1 select-all break-all font-mono text-lg text-slate-800">—</span>
      <button type="button" data-copy-btn class="rounded-lg bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700">
        Copy
      </button>
    </div>

    <div class="mb-3">
      <div class="mb-1 flex items-center justify-between text-xs text-slate-500">
        <span>Strength</span>
        <span data-strength-label class="font-medium">—</span>
      </div>
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
        <div data-strength-bar class="h-full w-0 rounded-full transition-all"></div>
      </div>
    </div>

    <button type="button" data-generate-btn
      class="w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-700">
      Generate New
    </button>
  </div>

  <p class="mt-3 text-xs text-slate-400">
    Generated using your browser's cryptographically secure random source. Nothing is sent to a server or stored.
  </p>
</div>

<script>
  const WORD_LIST = [
    "abandon","ability","absorb","academy","accent","acid","across","action","actor","adapt",
    "add","admit","adult","advice","afraid","again","agent","agree","ahead","alarm",
    "album","alert","alike","alive","allow","almost","alone","along","alpha","already",
    "also","alter","always","amber","amount","amuse","angle","animal","ankle","annual",
    "answer","antique","anxiety","apart","apple","apply","arcade","area","arena","argue",
    "arm","armor","around","arrest","arrive","arrow","art","artist","aside","ask",
    "asset","attack","attend","august","author","auto","autumn","avoid","awake","aware",
    "away","awful","axis","baby","bacon","badge","balance","balcony","ball","bamboo",
    "banana","banner","bar","barely","bargain","barrel","base","basic","basket","battle",
    "beach","bean","bear","beauty","become","before","begin","behave","behind","believe",
    "belt","bench","benefit","best","better","between","beyond","bicycle","bike","binary",
    "biology","bird","birth","bitter","black","blade","blame","blanket","blast","bleak",
    "blend","bless","blind","blood","blossom","blue","blur","board","boat","body",
    "boil","bold","bolt","bomb","bond","bonus","book","boost","border","boring",
    "borrow","boss","bottom","bounce","box","boy","brain","brand","brave","bread",
    "break","breeze","brick","bridge","brief","bright","bring","broken","bronze","broom",
    "brother","brown","brush","bubble","buddy","budget","buffalo","build","bulb","bulk",
    "bullet","bundle","bunker","burden","burger","burst","bus","business","busy","butter",
  ];

  function pickSecureRandom<T>(arr: T[]): T {
    const idx = Math.floor((crypto.getRandomValues(new Uint32Array(1))[0] / (0xffffffff + 1)) * arr.length);
    return arr[idx];
  }

  function generatePassword(length: number, opts: Record<string, boolean>): string {
    let charset = "";
    let excludeChars = opts.excludeAmbiguous ? "l1IO0" : "";
    if (opts.uppercase) charset += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    if (opts.lowercase) charset += "abcdefghijklmnopqrstuvwxyz";
    if (opts.numbers) charset += "0123456789";
    if (opts.symbols) charset += "!@#$%^&*()_+-=[]{}|;:,.<>?";
    if (excludeChars) {
      charset = charset
        .split("")
        .filter((c) => !excludeChars.includes(c))
        .join("");
    }
    if (!charset) return "";

    const bytes = crypto.getRandomValues(new Uint32Array(length));
    let result = "";
    for (let i = 0; i < length; i++) {
      result += charset[bytes[i] % charset.length];
    }
    return result;
  }

  function generatePassphrase(wordCount: number, separator: string, opts: Record<string, boolean>): string {
    const words: string[] = [];
    for (let i = 0; i < wordCount; i++) {
      let word = pickSecureRandom(WORD_LIST);
      if (opts.capitalize) word = word[0].toUpperCase() + word.slice(1);
      words.push(word);
    }
    if (opts.includeNumber) {
      const num = crypto.getRandomValues(new Uint32Array(1))[0] % 100;
      words.splice(Math.floor(Math.random() * words.length), 0, String(num));
    }
    return words.join(separator || "-");
  }

  function estimateStrength(text: string, entropyBits: number): { label: string; percent: number; color: string } {
    if (!text) return { label: "—", percent: 0, color: "bg-slate-300" };
    if (entropyBits < 40) return { label: "Weak", percent: 25, color: "bg-red-500" };
    if (entropyBits < 60) return { label: "Fair", percent: 50, color: "bg-amber-500" };
    if (entropyBits < 80) return { label: "Strong", percent: 75, color: "bg-blue-500" };
    return { label: "Very strong", percent: 100, color: "bg-green-500" };
  }

  function initPasswordGenerator(root: HTMLElement) {
    const modeBtns = root.querySelectorAll<HTMLButtonElement>("[data-mode-btn]");
    const passwordPanel = root.querySelector<HTMLDivElement>("[data-password-panel]")!;
    const passphrasePanel = root.querySelector<HTMLDivElement>("[data-passphrase-panel]")!;
    const lengthInput = root.querySelector<HTMLInputElement>("[data-length-input]")!;
    const lengthValue = root.querySelector<HTMLSpanElement>("[data-length-value]")!;
    const wordCountInput = root.querySelector<HTMLInputElement>("[data-word-count-input]")!;
    const wordCountValue = root.querySelector<HTMLSpanElement>("[data-word-count-value]")!;
    const separatorInput = root.querySelector<HTMLInputElement>("[data-separator-input]")!;
    const output = root.querySelector<HTMLSpanElement>("[data-output]")!;
    const copyBtn = root.querySelector<HTMLButtonElement>("[data-copy-btn]")!;
    const generateBtn = root.querySelector<HTMLButtonElement>("[data-generate-btn]")!;
    const strengthLabel = root.querySelector<HTMLSpanElement>("[data-strength-label]")!;
    const strengthBar = root.querySelector<HTMLDivElement>("[data-strength-bar]")!;

    let mode: "password" | "passphrase" = "password";

    function getOpts(): Record<string, boolean> {
      const opts: Record<string, boolean> = {};
      root.querySelectorAll<HTMLInputElement>("[data-opt]").forEach((el) => {
        opts[el.dataset.opt!] = el.checked;
      });
      return opts;
    }

    function setMode(m: "password" | "passphrase") {
      mode = m;
      modeBtns.forEach((btn) => {
        const active = btn.dataset.mode === m;
        btn.classList.toggle("bg-blue-600", active);
        btn.classList.toggle("text-white", active);
        btn.classList.toggle("text-slate-500", !active);
      });
      passwordPanel.classList.toggle("hidden", m !== "password");
      passphrasePanel.classList.toggle("hidden", m !== "passphrase");
      generate();
    }

    function generate() {
      const opts = getOpts();
      let result = "";
      let entropyBits = 0;

      if (mode === "password") {
        const length = parseInt(lengthInput.value, 10);
        result = generatePassword(length, opts);
        let poolSize = 0;
        if (opts.uppercase) poolSize += 26;
        if (opts.lowercase) poolSize += 26;
        if (opts.numbers) poolSize += 10;
        if (opts.symbols) poolSize += 26;
        entropyBits = length * Math.log2(Math.max(poolSize, 1));
      } else {
        const wordCount = parseInt(wordCountInput.value, 10);
        result = generatePassphrase(wordCount, separatorInput.value, opts);
        entropyBits = wordCount * Math.log2(WORD_LIST.length) + (opts.includeNumber ? Math.log2(100) : 0);
      }

      output.textContent = result || "Select at least one character type";

      const strength = estimateStrength(result, entropyBits);
      strengthLabel.textContent = strength.label;
      strengthBar.style.width = `${strength.percent}%`;
      strengthBar.className = `h-full rounded-full transition-all ${strength.color}`;
    }

    modeBtns.forEach((btn) => btn.addEventListener("click", () => setMode(btn.dataset.mode as "password" | "passphrase")));

    lengthInput.addEventListener("input", () => {
      lengthValue.textContent = lengthInput.value;
      generate();
    });
    wordCountInput.addEventListener("input", () => {
      wordCountValue.textContent = wordCountInput.value;
      generate();
    });
    separatorInput.addEventListener("input", generate);
    root.querySelectorAll<HTMLInputElement>("[data-opt]").forEach((el) => el.addEventListener("change", generate));
    generateBtn.addEventListener("click", generate);

    copyBtn.addEventListener("click", async () => {
      const text = output.textContent ?? "";
      if (!text || text.startsWith("Select")) return;
      await navigator.clipboard.writeText(text);
      copyBtn.textContent = "Copied!";
      setTimeout(() => (copyBtn.textContent = "Copy"), 1500);
    });

    setMode("password");
  }

  document.querySelectorAll<HTMLElement>("[data-password-generator]").forEach(initPasswordGenerator);
</script>